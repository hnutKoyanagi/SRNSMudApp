@using SRNSMudApp.Data
@using SRNSMudApp.Models.Unions
@using UserGroupEntity = SRNSMudApp.Data.UserGroup

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.subtitle1" Class="mb-3">
            グループ: <strong>@Group.Name</strong>
        </MudText>

        @if (ViewModel.IsOwner)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-4 rounded-lg">
                <MudText Typo="Typo.subtitle2" Class="mb-2">新規メンバー追加</MudText>
                <div class="d-flex align-center gap-2">
                    <MudAutocomplete T="ApplicationUser" @bind-Value="ViewModel.SelectedUser" SearchFunc="@SearchUsersAsync"
                                     ToStringFunc="@(u => u?.UserName ?? string.Empty)" Label="ユーザー名で検索" Variant="Variant.Outlined"
                                     Dense="true" Margin="Margin.Dense" Class="flex-grow-1" Placeholder="追加するユーザーを検索..." />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@AddMemberAsync"
                               Disabled="@(!ViewModel.CanAddMember)">
                        @if (ViewModel.IsAdding)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                            <span>追加中...</span>
                        }
                        else
                        {
                            <span>追加</span>
                        }
                    </MudButton>
                </div>
            </MudPaper>
        }

        <MudText Typo="Typo.subtitle2" Class="mb-2">メンバー一覧 (@ViewModel.Members.Count 人)</MudText>
        @if (ViewModel.IsLoading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
        else
        {
            <MudList T="UserGroupMember" Dense="true">
                @foreach (var member in ViewModel.Members)
                {
                    <MudListItem T="UserGroupMember">
                        <div class="d-flex align-center justify-space-between width-100">
                            <div class="d-flex align-center gap-2">
                                <MudAvatar Color="Color.Secondary" Size="Size.Small">
                                    @(member.User?.UserName?.FirstOrDefault().ToString().ToUpperInvariant() ?? "U")
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.body2">
                                        @member.User?.UserName
                                        @if (member.UserId == Group.OwnerId)
                                        {
                                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Class="ml-2">オーナー</MudChip>
                                        }
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        参加: @member.CreatedDate.ToLocalTime().ToString("g")
                                    </MudText>
                                </div>
                            </div>
                            @if (ViewModel.IsOwner && member.UserId != Group.OwnerId)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Color="Color.Error" Size="Size.Small"
                                               Title="メンバーから削除" OnClick="@(() => RemoveMemberAsync(member.UserId))"
                                               Disabled="@ViewModel.IsRemoving" />
                            }
                        </div>
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="@Close">閉じる</MudButton>
    </DialogActions>
</MudDialog>


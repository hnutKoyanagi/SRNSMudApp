@page "/Admin/RequireConfirmedAccount"
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using SRNSMudApp.Data
@using SRNSMudApp.Models.Unions
@attribute [Authorize(Roles = "Admin")]
@inject RequireConfirmedAccountViewModel ViewModel
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-4">Require Confirmed Account (Debug)</MudText>
    
    @if (ViewModel.Users == null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudTable Items="@ViewModel.Users" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>Email</MudTh>
                <MudTh>Confirmed</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Email">@context.Email</MudTd>
                <MudTd DataLabel="Confirmed">
                    @if (context.EmailConfirmed)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Confirmed</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">Unconfirmed</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Action">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               OnClick="@(() => ToggleConfirmationAsync(context))">
                        Toggle
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadUsersAsync();
    }

    private async Task ToggleConfirmationAsync(ApplicationUser user)
    {
        var result = await ViewModel.ToggleConfirmationAsync(user);
        if (result is Success<bool> success)
        {
            Snackbar.Add($"Updated {user.Email}", Severity.Success);
        }
        else if (result is Failure failure)
        {
            Snackbar.Add(failure.ErrorMessage, Severity.Error);
        }
    }
}

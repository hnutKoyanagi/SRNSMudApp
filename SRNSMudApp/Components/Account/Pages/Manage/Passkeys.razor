@page "/Account/Manage/Passkeys"

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Manage your passkeys</PageTitle>

<MudText Typo="Typo.h6" GutterBottom="true">Manage your passkeys</MudText>

<StatusMessage />

@if (currentPasskeys is { Count: > 0 })
{
    <table class="table" data-testid="passkeys-table">
        <tbody>
            @foreach (var passkey in currentPasskeys)
            {
                var credentialId = PasskeysViewModel.EncodeCredentialId(passkey.CredentialId);
                <tr data-testid="@($"passkey-row-{credentialId}")">
                    <td data-testid="@($"passkey-name-{credentialId}")">@PasskeysViewModel.FormatPasskeyName(passkey.Name)</td>
                    <td>
                        <form @formname="@($"update-passkey-{credentialId}")" @onsubmit="UpdatePasskey" method="post">
                            <AntiforgeryToken />
                            <div>
                                <input type="hidden" name="CredentialId" value="@credentialId" />
                                <button type="submit" name="Action" value="rename" class="btn btn-primary"
                                        title="Rename this passkey" data-testid="@($"rename-passkey-{credentialId}")">
                                    Rename
                                </button>
                                <button type="submit" name="Action" value="delete" class="btn btn-danger"
                                        title="Remove this passkey from your account"
                                        data-testid="@($"delete-passkey-{credentialId}")">
                                    Delete
                                </button>
                            </div>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <MudText Typo="Typo.body1" data-testid="no-passkeys-message">@PasskeysViewModel.NoPasskeysMessage</MudText>
}

<form @formname="add-passkey" @onsubmit="AddPasskey" method="post">
    <AntiforgeryToken />
    @if (!PasskeysViewModel.CanAddPasskey(currentPasskeys?.Count ?? 0))
    {
        <MudText Typo="Typo.body2" Color="Color.Error" data-testid="max-passkeys-warning">
            You have reached the maximum number of allowed passkeys. Please
            delete one before adding a new one.
        </MudText>
    }
    else
    {
        <PasskeySubmit Operation="PasskeyOperation.Create" Name="Input" class="btn btn-primary"
                       data-testid="add-passkey-button">
            Add a new passkey
        </PasskeySubmit>
    }
</form>

@code {
    private ApplicationUser? user;
    private IList<UserPasskeyInfo>? currentPasskeys;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private string? Action { get; set; }

    [SupplyParameterFromForm] private string? CredentialId { get; set; }

    [SupplyParameterFromForm(FormName = "add-passkey")]
    private PasskeyInputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new PasskeyInputModel();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        currentPasskeys = await UserManager.GetPasskeysAsync(user);
    }

    private async Task AddPasskey()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (!string.IsNullOrEmpty(Input.Error))
        {
            RedirectManager.RedirectToCurrentPageWithStatus($"Error: {Input.Error}", HttpContext);
            return;
        }

        if (string.IsNullOrEmpty(Input.CredentialJson))
        {
            RedirectManager.RedirectToCurrentPageWithStatus(PasskeysViewModel.MissingBrowserPasskeyMessage, HttpContext);
            return;
        }

        if (!PasskeysViewModel.CanAddPasskey(currentPasskeys?.Count ?? 0))
        {
            RedirectManager.RedirectToCurrentPageWithStatus(PasskeysViewModel.MaxPasskeyCountMessage, HttpContext);
            return;
        }

        var attestationResult = await SignInManager.PerformPasskeyAttestationAsync(Input.CredentialJson);
        if (!attestationResult.Succeeded)
        {
            RedirectManager.RedirectToCurrentPageWithStatus(PasskeysViewModel.FormatAttestationError(attestationResult.Failure.Message),
HttpContext);
            return;
        }

        var addPasskeyResult = await UserManager.AddOrUpdatePasskeyAsync(user, attestationResult.Passkey);
        if (!addPasskeyResult.Succeeded)
        {
            RedirectManager.RedirectToCurrentPageWithStatus(PasskeysViewModel.PasskeyAddFailedMessage, HttpContext);
            return;
        }

        var credentialIdBase64Url = PasskeysViewModel.EncodeCredentialId(attestationResult.Passkey.CredentialId);
        RedirectManager.RedirectTo($"Account/Manage/RenamePasskey/{credentialIdBase64Url}");
    }

    private async Task UpdatePasskey()
    {
        switch (Action)
        {
            case "rename":
                RedirectManager.RedirectTo($"Account/Manage/RenamePasskey/{CredentialId}");
                break;
            case "delete":
                await DeletePasskey();
                break;
            default:
                RedirectManager.RedirectToCurrentPageWithStatus(PasskeysViewModel.FormatUnknownActionError(Action), HttpContext);
                break;
        }
    }

    private async Task DeletePasskey()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (!PasskeysViewModel.TryDecodeCredentialId(CredentialId, out byte[] credentialId))
        {
            RedirectManager.RedirectToCurrentPageWithStatus(PasskeysViewModel.InvalidCredentialIdFormatMessage, HttpContext);
            return;
        }

        var result = await UserManager.RemovePasskeyAsync(user, credentialId);
        if (!result.Succeeded)
        {
            RedirectManager.RedirectToCurrentPageWithStatus(PasskeysViewModel.PasskeyDeleteFailedMessage, HttpContext);
            return;
        }

        RedirectManager.RedirectToCurrentPageWithStatus(PasskeysViewModel.PasskeyDeleteSuccessMessage, HttpContext);
    }
}
@page "/Contract/ContractManagement"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@namespace SRNSMudApp.Components.Contract


<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true">コントラクト管理</MudText>

    @* ページ状態の描画は AsyncPageView (RenderFragment 差し替え) に委譲する (mainRules: 条件文回避) *@
    <SRNSMudApp.Components.UI.AsyncPageView T="ContractManagementData" State="ViewModel.PageState">
        <LoadingContent>
            <MudProgressCircular Indeterminate="true" />
        </LoadingContent>
        <FailedContent Context="failed">
            <MudAlert Severity="Severity.Error">エラーが発生しました: @failed.Message</MudAlert>
        </FailedContent>
        <LoadedContent Context="loaded">
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Class="mt-4">
                <MudTabPanel Text="受信トレイ (Inbox)">
                    <div class="pa-4">
                        @if (!loaded.IncomingContracts.Any())
                        {
                            <MudAlert Severity="Severity.Info">現在、受信したコントラクトの提案はありません。</MudAlert>
                        }
                        else
                        {
                            <MudGrid>
                                @foreach (var contract in loaded.IncomingContracts)
                                {
                                    <MudItem xs="12" sm="6" md="4" @key="contract.Id">
                                        <MudCard Elevation="3">
                                            <MudCardHeader>
                                                <CardHeaderContent>
                                                    <MudText Typo="Typo.h6">@contract.RequestedTag.Name</MudText>
                                                    <MudText Typo="Typo.body2">対象アイテム: @contract.TargetItem.Content</MudText>
                                                </CardHeaderContent>
                                            </MudCardHeader>
                                            <MudCardContent>
                                                <MudChip T="string"
                                                         Color="@ContractManagementViewModel.GetStatusColor(contract.Status)"
                                                         Size="Size.Small">
                                                    @ContractManagementViewModel.GetStatusDisplayText(contract.Status)
                                                </MudChip>
                                                <ContractCardContent Contract="contract" />
                                            </MudCardContent>
                                            <MudCardActions>
                                                <MudButton Color="Color.Success" Variant="Variant.Filled"
                                                           OnClick="() => AcceptContract(contract)">
                                                    承認する
                                                </MudButton>
                                                <MudButton Color="Color.Error" Variant="Variant.Text" Class="ml-2"
                                                           OnClick="() => RejectContract(contract)">
                                                    拒否する
                                                </MudButton>
                                            </MudCardActions>
                                        </MudCard>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="送信済み (Outbox)">
                    <div class="pa-4">
                        @if (!loaded.OutgoingContracts.Any())
                        {
                            <MudAlert Severity="Severity.Info">現在、送信したコントラクトの提案はありません。</MudAlert>
                        }
                        else
                        {
                            <MudGrid>
                                @foreach (var contract in loaded.OutgoingContracts)
                                {
                                    <MudItem xs="12" sm="6" md="4" @key="contract.Id">
                                        <MudCard Elevation="3">
                                            <MudCardHeader>
                                                <CardHeaderContent>
                                                    <MudText Typo="Typo.h6">@contract.RequestedTag.Name</MudText>
                                                    <MudText Typo="Typo.body2">対象アイテム: @contract.TargetItem.Content</MudText>
                                                </CardHeaderContent>
                                            </MudCardHeader>
                                            <MudCardContent>
                                                <MudChip T="string"
                                                         Color="@ContractManagementViewModel.GetStatusColor(contract.Status)"
                                                         Size="Size.Small">
                                                    @ContractManagementViewModel.GetStatusDisplayText(contract.Status)
                                                </MudChip>
                                                <ContractCardContent Contract="contract" />
                                            </MudCardContent>
                                            <MudCardActions>
                                                @if (ContractManagementViewModel.CanCancelContract(contract))
                                                {
                                                    <MudButton Color="Color.Error" Variant="Variant.Text"
                                                               OnClick="() => CancelContract(contract)">
                                                        取り下げる
                                                    </MudButton>
                                                }
                                            </MudCardActions>
                                        </MudCard>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                    </div>
                </MudTabPanel>
            </MudTabs>
        </LoadedContent>
    </SRNSMudApp.Components.UI.AsyncPageView>
</MudContainer>
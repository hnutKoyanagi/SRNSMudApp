@namespace SRNSMudApp.Components.Contract
@using System.Security.Claims
@using SRNSMudApp.Services
@using ItemEntity = SRNSMudApp.Data.Item
@using TagEntity = SRNSMudApp.Data.Tag

<MudDialog>
    <DialogContent>
        <MudForm @bind-IsValid="@_isValid">
            <MudText Typo="Typo.body1" Class="mb-4">
                あなたはこのタグの操作権限を持っていません。<br />
                タグの作成者に@(IsRemovalRequest ? "タグの削除" : "タグ付け")のリクエスト（コントラクト）を提案しますか？
            </MudText>

            @if (TargetItem is not null)
            {
                <MudTextField T="string" Label="対象のアイテム" Value="@TargetItem.Content" ReadOnly="true" />
            }
            else
            {
                <MudAutocomplete T="ItemEntity" Label="対象のアイテム" @bind-Value="_selectedTargetItem" SearchFunc="@SearchItems"
                                 ToStringFunc="@(i => i?.Content ?? "")" Required="true" RequiredError="対象のアイテムを選択してください"
                                 ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
            }
            <MudTextField T="string" Label="希望するタグ" Value="@RequestedTag.Name" ReadOnly="true" />

            @if (IsRemovalRequest)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2 mb-4">
                    タグの削除提案
                </MudAlert>
            }
            else
            {
                <div class="d-flex align-center gap-4 mt-2 mb-4">
                    <MudText Typo="Typo.body2">提案するWeight変更（増減）:</MudText>
                    <MudNumericField @bind-Value="ProposedWeightInput" Required="true" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Style="max-width: 150px" />
                </div>
            }

            <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Elevation="1" Rounded="true"
                     ApplyEffectsToContainer="true" Class="mt-4">
                <MudTabPanel Text="無償のお願い (Gratis)">
                    <div class="pa-4">
                        <MudTextField T="string" Label="メッセージ（任意）" @bind-Value="_gratisMessage" Lines="3"
                                      MaxLength="200" />
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="相互タグ付け (Mutual)">
                    <div class="pa-4">
                        <MudText Typo="Typo.body2" Class="mb-2">
                            代わりにあなたが提供するタグとアイテムを選択してください。
                        </MudText>

                        <MudAutocomplete T="ItemEntity" Label="提供するアイテム" @bind-Value="_offeredItem" SearchFunc="@SearchItems"
                                         ToStringFunc="@(i => i?.Content ?? "")" Required="@(_activeTabIndex == 1)"
                                         RequiredError="アイテムを選択してください" ResetValueOnEmptyText="true" CoerceText="true"
                                         CoerceValue="true" />

                        <MudAutocomplete T="TagEntity" Label="提供するタグ" @bind-Value="_offeredTag" SearchFunc="@SearchTags"
                                         ToStringFunc="@(t => t?.Name ?? "")" Required="@(_activeTabIndex == 1)"
                                         RequiredError="タグを選択してください" ResetValueOnEmptyText="true" CoerceText="true"
                                         CoerceValue="true" />

                        <MudSelect T="RightAsset" Label="消費するアセット（必須）" @bind-Value="_selectedRightAsset"
                                   Clearable="true" Required="@(_activeTabIndex == 1)" RequiredError="相互タグ付けにはアセットが必要です"
                                   ToStringFunc="@(a => a?.TargetTag?.Name != null ? $"[ID: {a.Id}] {a.TargetTag.Name} の権利" : "")">
                            @foreach (var asset in _myAssets)
                            {
                                <MudSelectItem Value="@asset" />
                            }
                        </MudSelect>
                    </div>
                </MudTabPanel>
            </MudTabs>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">
            提案する
        </MudButton>
    </DialogActions>
</MudDialog>
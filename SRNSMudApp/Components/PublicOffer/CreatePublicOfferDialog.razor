<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudAutocomplete T="Tag" Label="提供するタグ（自分が作成したタグのみ）" @bind-Value="ViewModel.SelectedTag"
                             SearchFunc="@SearchMyTags" ToStringFunc="@(t => t?.Name ?? "")" Required="true"
                             RequiredError="タグを選択してください" ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />

            <MudNumericField T="int" Label="要求するアセット量" @bind-Value="ViewModel.RequiredAssetAmount" Min="0"
                             HelperText="0の場合は無償で提供します。" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!_isValid)">
            公開する
        </MudButton>
    </DialogActions>
</MudDialog>
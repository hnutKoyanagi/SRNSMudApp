@page "/PublicOffer/PublicOfferBoard"
@using System.Security.Claims
@using SRNSMudApp.Models.Unions
@using SRNSMudApp.Services
@rendermode InteractiveServer

@attribute [Authorize]

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true">公開オファー掲示板</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">他のユーザーが提供しているタグの公開オファー一覧です。</MudText>

    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog" Class="mb-6">
        オファーを作成する
    </MudButton>

    @if (ViewModel.IsLoading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!ViewModel.Offers.Any())
    {
        <MudAlert Severity="Severity.Info">現在、アクティブな公開オファーはありません。</MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var offer in ViewModel.Offers)
            {
                <MudItem xs="12" sm="6" md="4" @key="offer.Id">
                    <MudCard Elevation="3">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@offer.OfferedTag.Name</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    提供者: @offer.Owner?.UserName
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            @if (offer.RequiredAssetAmount > 0)
                            {
                                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2 py-1 px-2"
                                          Style="font-size: 0.8rem;">
                                    要求アセット量: @offer.RequiredAssetAmount
                                </MudAlert>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-2 py-1 px-2"
                                          Style="font-size: 0.8rem;">
                                    無償で提供
                                </MudAlert>
                            }
                        </MudCardContent>
                        <MudCardActions>
                            @if (ViewModel.IsOwner(offer))
                            {
                                <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="() => DeactivateOffer(offer)">
                                    取り下げる
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="() => TriggerOffer(offer)">
                                    オファーに応じる
                                </MudButton>
                            }
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

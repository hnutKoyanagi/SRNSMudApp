<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudText Typo="Typo.body1" Class="mb-4">
                以下のオファーを実行してタグを受け取ります。
            </MudText>

            <MudAlert Severity="Severity.Info" Class="mb-4">
                提供されるタグ: @Offer.OfferedTag.Name<br />
                要求されるアセット量: @(Offer.RequiredAssetAmount > 0 ? Offer.RequiredAssetAmount.ToString() : "無償")
            </MudAlert>

            <MudAutocomplete T="Item" Label="タグを付与する対象のアイテム" @bind-Value="SelectedItem" SearchFunc="@SearchItems"
                             ToStringFunc="@(i => i?.Content ?? "")" Required="true" RequiredError="アイテムを選択してください"
                             ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />

            @if (Offer.RequiredAssetAmount > 0)
            {
                <MudSelect T="RightAsset" Label="消費するアセット（必須）" @bind-Value="SelectedAsset" Clearable="true" Required="true"
                           RequiredError="要求量以上のアセットを選択してください"
                           ToStringFunc="@(a => a?.TargetTag?.Name != null ? $"[ID: {a.Id}] {a.TargetTag.Name} の権利 (量: {a.Amount})" : "")">
                    @foreach (var asset in ValidAssets)
                    {
                        <MudSelectItem Value="@asset" />
                    }
                </MudSelect>
                @if (ValidAssets.Count == 0)
                {
                    <MudText Color="Color.Error" Typo="Typo.caption">条件を満たすアセットを所有していません。</MudText>
                }
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@(!_isValid || (Offer.RequiredAssetAmount > 0 && ValidAssets.Count == 0))">
            実行する
        </MudButton>
    </DialogActions>
</MudDialog>
@using SRNSMudApp.Data
@using TagEntity = SRNSMudApp.Data.Tag

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.BookmarkAdd" Class="mr-2" />
            Edge へのタグ紐付け
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Info" Dense="true">
                対象 Edge: <strong>@Edge.SourceTag?.Name</strong> → <strong>@Edge.TargetTag?.Name</strong>
            </MudAlert>

            <MudAutocomplete T="TagEntity" Label="紐付けるタグ" Value="ViewModel.SelectedTag" ValueChanged="OnTagSelected"
                             SearchFunc="SearchTags" ToStringFunc="@(t => t == null ? "" : $"{t.Name} (ID: {t.Id})")" Dense="true"
                             Variant="Variant.Outlined" ResetValueOnEmptyText="true" CoerceText="true" Required="true" />

            @if (ViewModel.IsLoadingAssets)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
            }
            else if (ViewModel.SelectedTag != null)
            {
                @if (ViewModel.AvailableAssets.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        タグ「@ViewModel.SelectedTag.Name」を紐付けるための所有 RightAsset（未消費の権利）がありません。
                    </MudAlert>
                }
                else
                {
                    @if (ViewModel.IsOwnerTag)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            タグ「@ViewModel.SelectedTag.Name」のオーナーであるため、RightAsset を利用できます（自動発行対応済み）。
                        </MudAlert>
                    }

                    <MudSelect T="RightAsset" Label="消費する RightAsset" @bind-Value="ViewModel.SelectedAsset" Variant="Variant.Outlined"
                               Dense="true" Required="true">
                        @foreach (var asset in ViewModel.AvailableAssets)
                        {
                            <MudSelectItem Value="@asset">
                                アセット ID: @asset.Id (残量: @asset.Amount)
                            </MudSelectItem>
                        }
                    </MudSelect>

                    <MudNumericField T="int" Label="付与 Weight" @bind-Value="ViewModel.Weight" Min="1"
                                     Max="@(ViewModel.SelectedAsset?.Amount ?? 1)" Variant="Variant.Outlined" Dense="true" />

                    <MudAlert Severity="Severity.Normal" Dense="true">
                        紐付けを行うと RightAsset が消費されます。紐付け解除時も RightAsset は返還されません（不可逆消費仕様）。
                    </MudAlert>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!ViewModel.CanSubmit)">
            紐付け実行
        </MudButton>
    </DialogActions>
</MudDialog>

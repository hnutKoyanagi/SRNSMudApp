@namespace SRNSMudApp.Components.Diagram
@using TagEntity = SRNSMudApp.Data.Tag

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.AddLink" Class="mr-2" />
            Edge（タグ間関係）の作成
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2">
                始点となるタグ（Source）と終点となるタグ（Target）を選択して、新しい有向エッジを作成します。
            </MudText>

            <MudAutocomplete T="TagEntity" Label="Source Tag (始点)" @bind-Value="_sourceTag"
                             SearchFunc="SearchSourceTags" ToStringFunc="@(t => t == null ? "" : $"{t.Name} (ID: {t.Id})")"
                             Dense="true" Variant="Variant.Outlined" ResetValueOnEmptyText="true" CoerceText="true"
                             Required="true" />

            <MudAutocomplete T="TagEntity" Label="Target Tag (終点)" @bind-Value="_targetTag"
                             SearchFunc="SearchTargetTags" ToStringFunc="@(t => t == null ? "" : $"{t.Name} (ID: {t.Id})")"
                             Dense="true" Variant="Variant.Outlined" ResetValueOnEmptyText="true" CoerceText="true"
                             Required="true" />

            @if (_sourceTag != null && _targetTag != null && _sourceTag.Id == _targetTag.Id)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    Source と Target に同じタグを指定することはできません。
                </MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!CanSubmit)">
            作成
        </MudButton>
    </DialogActions>
</MudDialog>


@implements IDisposable
@using Blazor.Diagrams
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Core.Events
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.Models.Base
@using SRNSMudApp.Data
@using TagEntity = SRNSMudApp.Data.Tag

<div class="diagram-canvas-wrapper" style="width: 100%; height: 100%; position: relative; min-height: 650px;">
    @if (_isMounted)
    {
        <CascadingValue Value="Diagram" IsFixed="true">
            <DiagramCanvas Class="diagram-canvas" />
        </CascadingValue>
    }
</div>

@code {
    [Parameter]
    public BlazorDiagram Diagram { get; set; } = null!;

    [Parameter]
    public EventCallback<TagEdge?> OnEdgeSelected { get; set; }

    [Parameter]
    public EventCallback<TagEntity?> OnNodeSelected { get; set; }

    [Parameter]
    public EventCallback<(int SourceTagId, int TargetTagId)> OnLinkCreated { get; set; }

    private bool _isMounted;
    private SelectableModel? _lastSelectionChangedModel;

    protected override void OnInitialized()
    {
        Diagram.RegisterComponent<TagEdgeLink, TagEdgeLinkWidget>(replace: true);
        Diagram.SelectionChanged += HandleSelectionChanged;
        Diagram.PointerClick += HandlePointerClick;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _isMounted = true;
            StateHasChanged();
        }
    }

    private void HandleSelectionChanged(SelectableModel model)
    {
        _lastSelectionChangedModel = model;
        if (model is TagEdgeLink link)
        {
            _ = OnEdgeSelected.InvokeAsync(link.Selected ? link.Edge : null);
        }
        else if (model is TagNode node)
        {
            _ = OnNodeSelected.InvokeAsync(node.Selected ? node.Tag : null);
        }
    }

    private void HandlePointerClick(Model? model, Blazor.Diagrams.Core.Events.PointerEventArgs args)
    {
        // 直前の PointerDown で SelectionChanged が発火していたモデルの場合は新規選択なので二重発火を防止
        if (model is SelectableModel selectable && ReferenceEquals(selectable, _lastSelectionChangedModel))
        {
            _lastSelectionChangedModel = null;
            return;
        }

        _lastSelectionChangedModel = null;

        // すでにフォーカスされているノードまたはエッジを再度クリックした場合はコールバックを発火してトグル解除を可能にする
        if (model is TagNode node)
        {
            _ = OnNodeSelected.InvokeAsync(node.Tag);
        }
        else if (model is TagEdgeLink link)
        {
            _ = OnEdgeSelected.InvokeAsync(link.Edge);
        }
        else if (model is LinkLabelModel label && label.Parent is TagEdgeLink parentLink)
        {
            _ = OnEdgeSelected.InvokeAsync(parentLink.Edge);
        }
    }

    public void Dispose()
    {
        Diagram.SelectionChanged -= HandleSelectionChanged;
        Diagram.PointerClick -= HandlePointerClick;
    }
}

@using SRNSMudApp.Services
@typeparam TItem where TItem : class, IDirectTaggable

<div class="d-flex flex-column gap-2">
    <MudText Typo="Typo.subtitle2">タグ</MudText>

    <div class="d-flex flex-wrap gap-1">
        @if (TargetEntity.Tags is { Count: > 0 })
        {
            @foreach (var tag in TargetEntity.Tags)
            {
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" CloseIcon="@Icons.Material.Filled.Close"
                         OnClose="@(_ => RemoveTagAsync(tag.Id))">
                    @tag.Name
                </MudChip>
            }
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">タグがありません</MudText>
        }
    </div>

    <div class="d-flex align-center gap-2 mt-2">
        <MudNumericField @bind-Value="ViewModel.NewTagId" Label="追加するタグID" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="AddTagAsync"
                   Disabled="@(!ViewModel.CanAdd)">
            追加
        </MudButton>
    </div>
</div>
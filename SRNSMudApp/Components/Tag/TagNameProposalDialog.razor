<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1">対象タグ</MudText>
        <MudText Typo="Typo.h6" Class="mb-4 d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" Class="mr-2" />
            @Tag.Name
        </MudText>

        <MudTextField T="string" Value="@Tag.Name" Label="現在のタグ名" Variant="Variant.Outlined" ReadOnly="true"
                      Class="mb-4" />

        <MudTextField T="string" @bind-Value="ViewModel.ProposedName" Label="提案する新しいタグ名" Variant="Variant.Outlined"
                      AutoFocus="true" Required="true" RequiredError="タグ名は必須です" MaxLength="100" Counter="100"
                      Validation="@(new Func<string, string?>(TagNameProposalViewModel.ValidateTagName))" Class="mb-4" />

        <MudTextField T="string" @bind-Value="ViewModel.Reason" Label="提案理由・コメント（任意）" Variant="Variant.Outlined" Lines="2"
                      Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@SubmitAsync"
                   Disabled="@ViewModel.IsSubmitting">提案を送信</MudButton>
    </DialogActions>
</MudDialog>

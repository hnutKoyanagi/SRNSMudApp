@using System.Security.Claims
@using SRNSMudApp.Data
@using SRNSMudApp.Models.Unions
@using SRNSMudApp.Services
@inject TagEditViewModel ViewModel
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField T="string" @bind-Value="ViewModel.EditName" Label="タグ名" Variant="Variant.Outlined" Class="mb-4"
                      AutoFocus="true" Required="true" RequiredError="タグ名は必須です" />

        <MudTextField T="string" @bind-Value="ViewModel.EditContent" Label="内容" Variant="Variant.Outlined" Lines="3"
                      MaxLines="5" Class="mb-4" />

        <MudSelect T="int" @bind-SelectedValues="ViewModel.SelectedGroupIds" Label="自動承認を許可するユーザーグループ"
                   MultiSelection="true" Variant="Variant.Outlined" Clearable="true"
                   HelperText="選択されたいずれかのグループに所属するユーザーからのタグ付けリクエストが自動承認されます。">
            @foreach (var group in ViewModel.MyGroups)
            {
                <MudSelectItem T="int" Value="@group.Id">@group.Name</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@SaveAsync" Disabled="@(!ViewModel.CanSave)">
            保存</MudButton>
        </DialogActions>
    </MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    [Parameter] public Tag Tag { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateTask;
        string? currentUserId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        bool isAdmin = auth.User.IsInRole("Admin");

        await ViewModel.InitializeAsync(Tag, currentUserId, isAdmin);
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task SaveAsync()
    {
        var result = await ViewModel.SaveAsync();
        if (result is Success<bool>)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
        else if (result is Failure failure)
        {
            var severity = failure.ErrorMessage.Contains("ロック", StringComparison.Ordinal)
                ? Severity.Warning
                : Severity.Error;
            Snackbar.Add(failure.ErrorMessage, severity);

            if (severity == Severity.Warning)
            {
                MudDialog.Cancel();
            }
        }
    }
}
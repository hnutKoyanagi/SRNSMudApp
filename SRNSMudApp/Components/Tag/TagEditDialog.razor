<MudDialog>
    <DialogContent>
        <MudTextField T="string" @bind-Value="ViewModel.EditName" Label="タグ名" Variant="Variant.Outlined" Class="mb-4"
                      AutoFocus="true" Required="true" RequiredError="タグ名は必須です" />

        <MudTextField T="string" @bind-Value="ViewModel.EditContent" Label="内容" Variant="Variant.Outlined" Lines="3"
                      MaxLines="5" Class="mb-4" />

        <MudSelect T="int" @bind-SelectedValues="ViewModel.SelectedGroupIds" Label="自動承認を許可するユーザーグループ"
                   MultiSelection="true" Variant="Variant.Outlined" Clearable="true"
                   HelperText="選択されたいずれかのグループに所属するユーザーからのタグ付けリクエストが自動承認されます。">
            @foreach (var group in ViewModel.MyGroups)
            {
                <MudSelectItem T="int" Value="@group.Id">@group.Name</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@SaveAsync" Disabled="@(!ViewModel.CanSave)">
            保存
        </MudButton>
    </DialogActions>
</MudDialog>
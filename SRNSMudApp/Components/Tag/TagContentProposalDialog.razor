<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1">対象タグ</MudText>
        <MudText Typo="Typo.h6" Class="mb-4 d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" Class="mr-2" />
            @Tag.Name
        </MudText>

        @if (!string.IsNullOrEmpty(Tag.Content))
        {
            <MudTextField T="string" Value="@Tag.Content" Label="現在の内容" Variant="Variant.Outlined"
                          Lines="3" ReadOnly="true" Class="mb-4" />
        }

        <MudTextField T="string" @bind-Value="ViewModel.ProposedContent" Label="提案する内容" Variant="Variant.Outlined"
                      Lines="4" AutoFocus="true" Required="true" RequiredError="提案内容は必須です" Class="mb-4" />

        <MudTextField T="string" @bind-Value="ViewModel.Reason" Label="提案理由・コメント（任意）" Variant="Variant.Outlined"
                      Lines="2" Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@SubmitAsync"
                   Disabled="@ViewModel.IsSubmitting">提案を送信</MudButton>
    </DialogActions>
</MudDialog>

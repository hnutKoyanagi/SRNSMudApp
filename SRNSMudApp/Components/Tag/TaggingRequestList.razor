@namespace SRNSMudApp.Components.Tag

<MudTable T="Data.TaggingRequestEntity" Items="[.. Requests.Where(r => r.Status != Data.TradeStatus.Rejected)]" Hover="true"
          Breakpoint="Breakpoint.Sm" Elevation="0" @bind-SelectedItem="SelectedRequest" OnRowClick="OnRowClicked"
          RowClassFunc="SelectedRowClassFunc">
    <HeaderContent>
        <MudTh>タイプ</MudTh>
        <MudTh>対象アイテム</MudTh>
        <MudTh>リクエスタ</MudTh>
        <MudTh>作成日時</MudTh>
        <MudTh>操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="タイプ">
            @switch (context.RequestType)
            {
                case Data.TaggingRequestType.Add:
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">追加 (+@(context.ProposedWeight))</MudChip>
                    break;
                case Data.TaggingRequestType.Remove:
                    <MudChip T="string" Color="Color.Error" Size="Size.Small">削除</MudChip>
                    break;
                case Data.TaggingRequestType.DecreaseWeight:
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">追加 (-@(context.ProposedWeight))</MudChip>
                    break;
            }
        </MudTd>
        <MudTd DataLabel="対象アイテム">
            <MudLink Href="@($"/ItemDetail/{context.TargetItemId}")">
                @(context.TargetItem?.Content ?? $"Item #{context.TargetItemId}")
            </MudLink>
        </MudTd>
        <MudTd DataLabel="リクエスタ">@context.Owner?.UserName</MudTd>
        <MudTd DataLabel="作成日時">@context.CreatedDate.ToLocalTime().ToString("g")</MudTd>
        <MudTd DataLabel="操作">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                       OnClick="@(() => OpenThreadDialog(context))" Class="mr-2">
                詳細・スレッド
            </MudButton>
            @if (CanApprove(context))
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                           data-testid="tagging-request-approve" OnClick="@(() => ApproveRequestAsync(context))" Class="mr-2">
                    承認
                </MudButton>
            }
            @if (RejectButtonTemplate is not null)
            {
                @RejectButtonTemplate(context)
            }
            else if (CanApprove(context))
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                           data-testid="tagging-request-reject" OnClick="@(() => RejectRequestAsync(context))">
                    却下
                </MudButton>
            }
        </MudTd>
    </RowTemplate>
</MudTable>
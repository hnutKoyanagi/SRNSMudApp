@page "/import-tag"
@attribute [Authorize]
@using System.Security.Claims
@using System.Text
@using SRNSMudApp.Services
@rendermode InteractiveServer
@inject IImportTagDataProvider ImportTagData
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<MudText Typo="Typo.h4" GutterBottom="true">タグインポート (CSV)</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    階層構造を持ったタグをCSVから一括インポートします。各行の左から右に向かって親子の階層関係になります。<br />
    3列以上の行がある場合、最後の2列は最下層タグの内容（Content）として改行で結合されて登録されます。<br />
    （例: <code>動物,哺乳類,犬,イヌ科の動物,ペットとして広く親しまれている</code> という行は「動物 > 哺乳類 > 犬（内容: イヌ科の動物\nペットとして広く親しまれている）」という構造を作成します）
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="3">
    <MudText Typo="Typo.h6" GutterBottom="true">インポート先タグ（必須）</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">
        選択したタグの子としてインポートします。親タグの選択は必須です。
    </MudText>
    <MudAutocomplete T="Tag" Label="親タグを検索" @bind-Value="_selectedParentTag" SearchFunc="@SearchTagsAsync"
                     ToStringFunc="@(tag => tag == null ? null : tag.Name)" Placeholder="タグ名を入力..."
                     ResetValueOnEmptyText="false" CoerceValue="true"
                     Clearable="true" Class="mb-4">
        <ItemTemplate Context="tag">
            <MudText Typo="Typo.body1">@tag.Name</MudText>
        </ItemTemplate>
        <NoItemsTemplate>
            <MudText Align="Align.Center" Class="px-4 py-2">
                一致するタグが見つかりません
            </MudText>
        </NoItemsTemplate>
    </MudAutocomplete>

    @if (_isAdmin)
    {
        <MudSwitch T="bool" @bind-Value="_importAsSystem" Label="システムタグとしてインポート (Owner: system)" Color="Color.Warning"
                   Class="mb-4" />
    }

    <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles" Accept=".csv">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
            CSVファイルを選択
        </MudButton>
    </MudFileUpload>

    @if (_file is not null)
    {
        <MudText Typo="Typo.body2" Class="mt-2">選択されたファイル: @_file.Name (@_file.Size bytes)</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Success" Class="mt-4" OnClick="@ImportData"
                   Disabled="@(_isImporting || _selectedParentTag == null)">
            @if (_isImporting)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">インポート中...</MudText>
            }
            else
            {
                <MudText>インポート実行</MudText>
            }
        </MudButton>
    }
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    public int Weight { get; set; } = 0;
    private IBrowserFile? _file;
    private bool _isImporting;
    private bool _isAdmin;
    private bool _importAsSystem;
    private string? _currentUserId;
    private Tag? _selectedParentTag;

    private async Task<IEnumerable<Tag>> SearchTagsAsync(string? value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(_currentUserId))
        {
            return [];
        }

        return await ImportTagData.SearchUserTagsAsync(_currentUserId!, value, token);
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        _currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        _isAdmin = authState.User.IsInRole("Admin");
    }

    private void UploadFiles(IBrowserFile? file)
    {
        _file = file;
    }

    private async Task ImportData()
    {
        if (_isImporting)
        {
            return;
        }

        if (_selectedParentTag is null)
        {
            Snackbar.Add("親タグを選択してください", Severity.Warning);
            return;
        }

        if (_file is null)
        {
            Snackbar.Add("ファイルが選択されていません", Severity.Warning);
            return;
        }

        if (string.IsNullOrEmpty(_currentUserId))
        {
            Snackbar.Add("ログインが必要です", Severity.Error);
            return;
        }

        _isImporting = true;

        try
        {
            // Read file content
            using var stream = _file.OpenReadStream(104857600); // Max 10MB
            using var reader = new StreamReader(stream, Encoding.UTF8);
            var content = await reader.ReadToEndAsync();

            TagImportResult result =
                await ImportTagData.ImportCsvTagsAsync(_currentUserId!, _selectedParentTag.Name, content, _isAdmin && _importAsSystem);

            Snackbar.Add($"インポートが完了しました。{result.CreatedCount}個のタグを新規作成、{result.UpdatedCount}個のタグを更新しました。", Severity.Success);
            _file = null;

            // Redirect to Tag Tree page
            NavigationManager.NavigateTo("/tag-tree");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"インポート中にエラーが発生しました: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isImporting = false;
            // StateHasChanged();
        }
    }

}
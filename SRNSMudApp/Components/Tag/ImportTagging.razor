@page "/import-tagging"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using System.Text
@using MudBlazor
@using SRNSMudApp.Data
@using SRNSMudApp.Models
@using SRNSMudApp.Models.Unions
@using SRNSMudApp.Services


<MudText Typo="Typo.h4" GutterBottom="true">タグ付け構造インポート (JSON)</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Item、Tag、TagRelation、および Tag間の Edge（タグ付け含む）を一括インポートします。<br/>
    未登録タグの親階層決定や内部リンクへの置き換えは、AIサジェストをもとにモーダルで確認・調整できます。
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="3">
    <MudStack Spacing="3">
        <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".json">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.CloudUpload">
                JSONファイルを選択
            </MudButton>
        </MudFileUpload>

        @if (_file != null)
        {
            <MudText Typo="Typo.body2">選択されたファイル: @_file.Name (@_file.Size bytes)</MudText>
        }

        <MudTextField T="string"
                      Label="JSONテキストを直接入力または貼り付け"
                      @bind-Value="ViewModel.JsonText"
                      Lines="10"
                      Variant="Variant.Outlined"
                      Placeholder="@PlaceholderJson" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.PlayArrow"
                   OnClick="StartImportAsync"
                   Disabled="@(!ViewModel.CanStart)">
            @if (ViewModel.IsProcessing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">@ViewModel.CurrentStatusText</MudText>
            }
            else
            {
                <MudText>インポート開始</MudText>
            }
        </MudButton>
    </MudStack>
</MudPaper>

@if (ViewModel.ImportResult != null)
{
    <MudAlert Severity="Severity.Success" Class="mb-4">
        <MudText Typo="Typo.h6">インポート完了！</MudText>
        <MudText Typo="Typo.body2">
            作成されたアイテム: @ViewModel.ImportResult.CreatedItemsCount 件<br />
            新規作成されたタグ: @ViewModel.TotalNewTagsCreated 件<br />
            作成されたタグリレーション: @ViewModel.ImportResult.CreatedRelationsCount 件<br />
            作成されたエッジ: @ViewModel.ImportResult.CreatedEdgesCount 件<br />
            作成されたエッジタグ付与: @ViewModel.ImportResult.CreatedAttachmentsCount 件
        </MudText>
    </MudAlert>

    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => NavigationManager.NavigateTo("/items"))">
        アイテム一覧へ
    </MudButton>
}


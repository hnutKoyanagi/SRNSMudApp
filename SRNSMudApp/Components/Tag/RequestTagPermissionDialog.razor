@using System.Security.Claims
@using SRNSMudApp.Data
@using SRNSMudApp.Models
@using SRNSMudApp.Services
@inject RequestTagPermissionViewModel ViewModel

<MudDialog>
    <DialogContent>
        <div class="d-flex align-center gap-2 mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Key" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                「@RequestedTag.Name」の操作権限リクエスト
            </MudText>
        </div>

        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            このタグの操作権限（RightAsset）を保有者から譲渡・交換してもらうリクエストを送信します。
        </MudText>

        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <!-- リクエスト先ユーザー選択 -->
            <MudSelect T="string" Label="リクエスト先ユーザー（必須）" @bind-Value="ViewModel.SelectedTargetUserId" Required="true"
                       RequiredError="リクエスト先のユーザーを選択してください" Variant="Variant.Outlined" Class="mb-3"
                       data-testid="request-target-user-select">
                @foreach (var user in ViewModel.SelectableUsers)
                {
                    <MudSelectItem Value="@user.UserId">
                        @user.DisplayName
                    </MudSelectItem>
                }
            </MudSelect>

            <!-- 要求数量 -->
            <MudNumericField T="int" Label="要求する操作権限の数量 (Amount)" @bind-Value="ViewModel.RequestedAmount" Min="1"
                             Required="true" RequiredError="要求数量は1以上を入力してください"
                             HelperText="@ViewModel.GetTargetUserAmountHelperText()" Variant="Variant.Outlined" Class="mb-3"
                             data-testid="request-amount-field" />

            <!-- 対価となる自分の操作権限（任意） -->
            <MudSelect T="int?" Label="対価として提供する自分の操作権限（任意）" @bind-Value="ViewModel.SelectedOfferedAssetId"
                       Clearable="true" Variant="Variant.Outlined" Class="mb-3" HelperText="未選択の場合は「無償でのリクエスト」となります"
                       data-testid="offered-asset-select">
                @foreach (var asset in ViewModel.MyAvailableAssets)
                {
                    <MudSelectItem Value="@((int?)asset.Id)">
                        @($"{asset.TargetTagName} の操作権限 (保有残高: {asset.Amount})")
                    </MudSelectItem>
                }
            </MudSelect>

            <!-- 対価提供数量 -->
            @if (ViewModel.SelectedOfferedAssetId.HasValue)
            {
                <MudNumericField T="int" Label="提供する対価の数量 (Amount)" @bind-Value="ViewModel.OfferedAmount" Min="1"
                                 Max="@ViewModel.GetSelectedAssetMaxAmount()" Required="true" RequiredError="提供数量は1以上を入力してください"
                                 HelperText="@($"保有残高: {ViewModel.GetSelectedAssetMaxAmount()}")" Variant="Variant.Outlined" Class="mb-3"
                                 data-testid="offered-amount-field" />
            }

            <!-- 依頼メッセージ -->
            <MudTextField T="string" Label="依頼メッセージ（任意）" @bind-Value="ViewModel.Message" Lines="3" MaxLength="500"
                          Counter="500" Placeholder="例: ○○の分類整理のため操作権限をいただけないでしょうか？" Variant="Variant.Outlined" Class="mb-2"
                          data-testid="request-message-field" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@SubmitAsync"
                   Disabled="@(ViewModel.IsSubmitting || string.IsNullOrWhiteSpace(ViewModel.SelectedTargetUserId))"
                   data-testid="submit-request-button">
            @if (ViewModel.IsSubmitting)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">送信中...</span>
            }
            else
            {
                <span>リクエストを送信</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter] public Tag RequestedTag { get; set; } = null!;
    [Parameter] public string? PresetTargetUserId { get; set; }
    [Parameter] public IReadOnlyList<RightAssetHolderSummary> AvailableHolders { get; set; } = [];

    private MudForm? _form;
    private bool _isValid = true;
    private string _currentUserId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var auth = await AuthState;
            _currentUserId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        }

        await ViewModel.InitializeAsync(RequestedTag, PresetTargetUserId, AvailableHolders, _currentUserId);
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task SubmitAsync()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_isValid) return;
        }

        bool success = await ViewModel.SubmitAsync(RequestedTag.Id, _currentUserId);
        if (success)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
    }
}

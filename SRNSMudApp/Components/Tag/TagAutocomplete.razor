@using SRNSMudApp.Data
@using SRNSMudApp.Services

<MudAutocomplete T="Tag" Label="@Label" Value="Value" ValueChanged="OnValueChanged" SearchFunc="@SearchTagsAsync"
                 ToStringFunc="@(tag => tag == null ? null : tag.Name)" Placeholder="@Placeholder"
                 ResetValueOnEmptyText="@ResetValueOnEmptyText" Clearable="@Clearable" Variant="@Variant" Dense="@Dense"
                 Margin="@Margin" Class="@Class" Style="@Style" MaxItems="@MaxItems">

    <ItemTemplate Context="tag">
        @if (ItemTemplate != null)
        {
            @ItemTemplate(tag)
        }
        else
        {
            <div class="d-flex flex-column">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" Color="Color.Primary"
                             Class="mr-1" />
                    <MudText Typo="Typo.body1" Class="font-weight-bold">@tag.Name</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                             Class="ml-2 px-1">
                        @tag.CachedWeight
                    </MudChip>
                </div>
                @if (!string.IsNullOrWhiteSpace(tag.Content))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @tag.Content
                    </MudText>
                }
            </div>
        }
    </ItemTemplate>

    <NoItemsTemplate>
        <MudText Align="Align.Center" Class="px-4 py-2">
            一致するタグが見つかりません
        </MudText>
    </NoItemsTemplate>
</MudAutocomplete>

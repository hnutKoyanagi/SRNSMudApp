@using SRNSMudApp.Data
@using SRNSMudApp.Models
@using SRNSMudApp.Services

@inject TagResolutionViewModel ViewModel

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.NewLabel" Class="mr-2" />
            未登録タグの解決: 「@TagName」
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Info" Dense="true">
                タグ <strong>「@TagName」</strong> (種別: @TagKind) はまだデータベースに存在しません。このタグの扱いを選択してください。
            </MudAlert>

            <MudRadioGroup T="TagResolutionAction" @bind-Value="ViewModel.Action">
                <MudRadio Value="TagResolutionAction.UseExisting" Color="Color.Secondary">
                    既存の別タグを割り当てる @(ViewModel.HasCandidate ? "(推奨)" : "")
                </MudRadio>
                <MudRadio Value="TagResolutionAction.CreateNew" Color="Color.Primary">
                    新規タグとして作成する
                </MudRadio>
            </MudRadioGroup>

            @if (ViewModel.Action == TagResolutionAction.UseExisting)
            {
                <MudPaper Class="pa-3" Outlined="true">
                    <MudAutocomplete T="Tag" Label="割り当てる既存タグを検索" @bind-Value="ViewModel.SelectedExistingTag"
                                     SearchFunc="SearchExistingTagsAsync"
                                     ToStringFunc="@(t => t == null ? "" : $"{t.Name} (ID: {t.Id})")" Placeholder="タグ名を入力..."
                                     ResetValueOnEmptyText="true" Clearable="true" Dense="true" Variant="Variant.Outlined" />

                    @if (ViewModel.InitialSuggestions.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                            割り当て候補タグ:
                        </MudText>
                        <MudChipSet T="Tag" SelectedValue="ViewModel.SelectedExistingTag"
                                    SelectedValueChanged="OnSuggestionSelected" SelectionMode="SelectionMode.SingleSelection"
                                    Class="mt-1">
                            @foreach (var tag in ViewModel.InitialSuggestions)
                            {
                                <MudChip T="Tag" Value="@tag"
                                         Color="@(ViewModel.SelectedExistingTag?.Id == tag.Id ? Color.Primary : Color.Default)"
                                         Variant="@(ViewModel.SelectedExistingTag?.Id == tag.Id ? Variant.Filled : Variant.Outlined)">
                                    @tag.Name (ID: @tag.Id)
                                </MudChip>
                            }
                        </MudChipSet>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Normal" Dense="true" Class="mt-2">
                            「@TagName」に一致する既存タグの候補はありません。上部の検索枠から手動で探すか、スキップ（デフォルト）してください。
                        </MudAlert>
                    }
                </MudPaper>
            }
            else if (ViewModel.Action == TagResolutionAction.CreateNew)
            {
                <MudPaper Class="pa-3" Outlined="true">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Class="mr-1" />
                        親タグ階層の決定（1階層目以降）
                    </MudText>

                    @if (SuggestedParentTag != null)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                            AIサジェスト親タグ: <strong>@SuggestedParentTag.Name</strong> (ID: @SuggestedParentTag.Id)
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-3">
                            サジェスト可能な親タグがありません。手動で親タグを選択してください。
                        </MudAlert>
                    }

                    <MudRadioGroup T="bool" Value="ViewModel.UseSuggestedParent" ValueChanged="OnUseSuggestedParentChanged">
                        <MudRadio Value="true" Color="Color.Primary" Disabled="@(SuggestedParentTag == null)">
                            サジェスト通りの親タグに紐付ける
                        </MudRadio>
                        <MudRadio Value="false" Color="Color.Secondary">
                            別の親タグを手動で選択する
                        </MudRadio>
                    </MudRadioGroup>

                    @if (!ViewModel.UseSuggestedParent || SuggestedParentTag == null)
                    {
                        <MudAutocomplete T="Tag" Label="親タグを検索・選択（1階層目以降）" @bind-Value="ViewModel.SelectedCustomParentTag"
                                         SearchFunc="SearchParentCandidateTagsAsync"
                                         ToStringFunc="@(t => t == null ? "" : $"{t.Name} (Level: {t.Node?.GetLevel() ?? 0})")"
                                         Placeholder="親タグ名を入力..." ResetValueOnEmptyText="true" Clearable="true" Dense="true"
                                         Variant="Variant.Outlined" Class="mt-2" />

                        @if (ViewModel.ParentSuggestions.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                親タグ候補（1階層目以降）:
                            </MudText>
                            <MudChipSet T="Tag" SelectedValue="ViewModel.SelectedCustomParentTag"
                                        SelectedValueChanged="OnParentSuggestionSelected" SelectionMode="SelectionMode.SingleSelection"
                                        Class="mt-1">
                                @foreach (var pTag in ViewModel.ParentSuggestions)
                                {
                                    <MudChip T="Tag" Value="@pTag"
                                             Color="@(ViewModel.SelectedCustomParentTag?.Id == pTag.Id ? Color.Primary : Color.Default)"
                                             Variant="@(ViewModel.SelectedCustomParentTag?.Id == pTag.Id ? Variant.Filled : Variant.Outlined)">
                                        @pTag.Name (Level: @(pTag.Node?.GetLevel() ?? 0))
                                    </MudChip>
                                }
                            </MudChipSet>
                        }
                    }
                </MudPaper>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="@(ViewModel.HasCandidate ? Color.Default : Color.Primary)"
                   Variant="@(ViewModel.HasCandidate ? Variant.Text : Variant.Filled)" OnClick="Skip">
            スキップ
        </MudButton>
        <MudButton Color="@(ViewModel.HasCandidate ? Color.Primary : Color.Default)"
                   Variant="@(ViewModel.HasCandidate ? Variant.Filled : Variant.Outlined)" OnClick="Submit"
                   Disabled="@(!ViewModel.CanSubmit)">
            決定
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string TagName { get; set; } = string.Empty;

    [Parameter]
    public string TagKind { get; set; } = "UserCustomTag";

    [Parameter]
    public Tag? SuggestedParentTag { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ViewModel.TagKind = TagKind;
        await ViewModel.InitializeAsync(TagName, SuggestedParentTag);
    }

    private void OnSuggestionSelected(Tag? tag)
    {
        ViewModel.SelectedExistingTag = tag;
    }

    private void OnParentSuggestionSelected(Tag? tag)
    {
        ViewModel.SelectedCustomParentTag = tag;
    }

    private void OnUseSuggestedParentChanged(bool useSuggested)
    {
        ViewModel.SetUseSuggestedParent(useSuggested);
    }

    private async Task<IEnumerable<Tag>> SearchParentCandidateTagsAsync(string? value, CancellationToken token)
    {
        return await ViewModel.SearchParentCandidateTagsAsync(value, token);
    }

    private async Task<IEnumerable<Tag>> SearchExistingTagsAsync(string? value, CancellationToken token)
    {
        return await ViewModel.SearchExistingTagsAsync(value, token);
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(ViewModel.CreateDecision()));
    }

    private void Skip()
    {
        MudDialog.Close(DialogResult.Ok(ViewModel.CreateSkipDecision()));
    }
}

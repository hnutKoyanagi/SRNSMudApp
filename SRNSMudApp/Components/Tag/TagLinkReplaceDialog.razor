@using SRNSMudApp.Data
@using SRNSMudApp.Models
@using SRNSMudApp.Services

@inject TagLinkReplaceViewModel ViewModel

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Link" Class="mr-2" />
            内部リンクへの置き換え確認
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Info" Dense="true">
                本文中にタグリンク候補が検出されました。内部リンク（<code>/TagDetail/{id}</code>）への置き換え方法を選択してください。
            </MudAlert>

            <MudPaper Class="pa-3" Outlined="true">
                <MudText Typo="Typo.caption" Color="Color.Secondary">元のリンク記述:</MudText>
                <MudText Typo="Typo.body2" Class="mb-2"><code>@OriginalMatchText</code></MudText>

                <MudText Typo="Typo.caption" Color="Color.Secondary">検出されたタグ名:</MudText>
                <MudText Typo="Typo.body1"><strong>@TagName</strong></MudText>
            </MudPaper>

            <MudRadioGroup T="TagLinkReplaceAction" @bind-Value="ViewModel.Action">
                <MudRadio Value="TagLinkReplaceAction.ReplaceWithFirstCandidate" Color="Color.Primary"
                          Disabled="@(FirstCandidateTag == null)">
                    サジェストの第1候補通りに置き換え
                    @if (FirstCandidateTag != null)
                    {
                        <span class="ml-1 text-muted">
                            (「@FirstCandidateTag.Name」 -> <code>/TagDetail/@FirstCandidateTag.Id</code>)
                        </span>
                    }
                </MudRadio>

                <MudRadio Value="TagLinkReplaceAction.ReplaceWithSelectedCandidate" Color="Color.Secondary">
                    他の候補タグを選択して置き換え
                </MudRadio>

                <MudRadio Value="TagLinkReplaceAction.DoNotReplace" Color="Color.Default">
                    置き換えない / スキップ (「@TagName」の文字のみ残し、リンク記号とURLは削除)
                </MudRadio>
            </MudRadioGroup>

            @if (ViewModel.Action == TagLinkReplaceAction.ReplaceWithSelectedCandidate)
            {
                <MudPaper Class="pa-3" Outlined="true">
                    <MudAutocomplete T="Tag" Label="置き換え先タグを検索・選択" @bind-Value="ViewModel.SelectedCustomTag"
                                     SearchFunc="SearchTagsAsync" ToStringFunc="@(t => t == null ? "" : $"{t.Name} (ID: {t.Id})")"
                                     Placeholder="タグ名を入力..." ResetValueOnEmptyText="true" Clearable="true" Dense="true"
                                     Variant="Variant.Outlined" />
                </MudPaper>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="@(FirstCandidateTag == null ? Color.Primary : Color.Default)"
                   Variant="@(FirstCandidateTag == null ? Variant.Filled : Variant.Text)" OnClick="Skip">
            スキップ
        </MudButton>
        <MudButton Color="@(FirstCandidateTag == null ? Color.Default : Color.Primary)"
                   Variant="@(FirstCandidateTag == null ? Variant.Outlined : Variant.Filled)" OnClick="Submit"
                   Disabled="@(!ViewModel.CanSubmit)">
            適用
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string OriginalMatchText { get; set; } = string.Empty;

    [Parameter]
    public string TagName { get; set; } = string.Empty;

    [Parameter]
    public Tag? FirstCandidateTag { get; set; }

    protected override void OnParametersSet()
    {
        ViewModel.OriginalMatchText = OriginalMatchText;
        ViewModel.TagName = TagName;
        ViewModel.SetCandidate(FirstCandidateTag);
    }

    private async Task<IEnumerable<Tag>> SearchTagsAsync(string? value, CancellationToken token)
    {
        return await ViewModel.SearchTagsAsync(value, token);
    }

    private void Skip()
    {
        MudDialog.Close(DialogResult.Ok(ViewModel.CreateSkipDecision()));
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(ViewModel.CreateDecision()));
    }
}


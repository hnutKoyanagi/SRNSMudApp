@page "/Tag/TagSearch"
@rendermode InteractiveServer
@inject TagSearchPageViewModel ViewModel

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
    <MudText Typo="Typo.h5" GutterBottom="true">タグ検索</MudText>

    <TagAutocomplete @bind-Value="ViewModel.SelectedTag" />

    @if (ViewModel.HasSelectedTag)
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">
            @ViewModel.SelectedTagSummary
        </MudAlert>
    }
</MudContainer>
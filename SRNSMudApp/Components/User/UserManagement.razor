@page "/User/Management"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using SRNSMudApp.Data
@using SRNSMudApp.Services
@inject UserManagementViewModel ViewModel

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-10">
    <MudText Typo="Typo.h4" GutterBottom="true">ユーザー管理</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">管理者（Admin）権限の付与・剥奪およびアカウントの利用停止（BAN）管理を行います。</MudText>

    @if (ViewModel.Users is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudTable Items="@ViewModel.Users" Hover="true" Dense="true" Elevation="3">
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Email (Username)</MudTh>
                <MudTh>Admin権限</MudTh>
                <MudTh>BAN（利用停止）</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID">@context.User.Id</MudTd>
                <MudTd DataLabel="Email">@context.User.UserName</MudTd>
                <MudTd DataLabel="Admin権限">
                    <MudSwitch T="bool" Value="@context.IsAdmin" ValueChanged="@(val => ViewModel.ToggleAdminAsync(context, val))"
                               Color="Color.Primary"
                               Disabled="@ViewModel.IsProtectedUser(context.User)" />
                </MudTd>
                <MudTd DataLabel="BAN（利用停止）">
                    <MudSwitch T="bool" Value="@context.IsBanned" ValueChanged="@(val => ViewModel.ToggleBanAsync(context, val))"
                               Color="Color.Error"
                               Disabled="@ViewModel.IsProtectedUser(context.User)" />
                    @if (context.IsBanned)
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Class="ml-2">利用停止中</MudChip>
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        string? currentUserId = null;
        if (AuthStateTask is not null)
        {
            AuthenticationState authState = await AuthStateTask;
            currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        }

        await ViewModel.InitializeAsync(currentUserId);
    }
}
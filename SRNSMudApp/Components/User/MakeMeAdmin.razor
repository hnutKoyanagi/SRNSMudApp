@page "/User/MakeMeAdmin"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IWebHostEnvironment Env
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
    <MudText Typo="Typo.h5" GutterBottom="true">デバッグ: Admin権限の切り替え</MudText>

    @if (!Env.IsDevelopment())
    {
        <MudAlert Severity="Severity.Error">このページは開発環境でのみ利用可能です。</MudAlert>
    }
    else
    {
        <MudText Class="mb-4">
            開発用機能です。現在のログインユーザーの「Admin」ロールの付与・解除（一般ユーザーに戻す）を行い、セッション（Cookie）を更新します。
        </MudText>

        <MudCard Class="pa-4">
            <MudCardContent>
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.subtitle1">現在の権限:</MudText>
                        <MudChip T="string" Color="@(_isAdmin ? Color.Success : Color.Default)" Size="Size.Small">
                            @(_isAdmin ? "管理者 (Admin)" : "一般ユーザー (User)")
                        </MudChip>
                    </MudStack>

                    <form id="toggleAdminForm" action="Account/MakeMeAdmin" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="enableAdmin" value="@_targetAdminState.ToString().ToLowerInvariant()" />
                        <input type="hidden" name="returnUrl" value="User/MakeMeAdmin" />

                        <MudSwitch T="bool"
                                   Value="_isAdmin"
                                   ValueChanged="OnToggleAdminChanged"
                                   Color="Color.Primary"
                                   Disabled="_isProcessing"
                                   Label="@(_isAdmin ? "Admin権限（ON: 管理者 / クリックで一般ユーザーに戻す）" : "Admin権限（OFF: 一般ユーザー / クリックでAdminにする）")" />

                        <button id="toggleAdminSubmitBtn" type="submit" style="display: none;"></button>
                    </form>

                    @if (_isProcessing)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
                    }
                </MudStack>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _isAdmin;
    private bool _targetAdminState;
    private bool _isProcessing;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateTask;
        _isAdmin = auth.User.IsInRole("Admin");
        _targetAdminState = !_isAdmin;
    }

    private async Task OnToggleAdminChanged(bool newValue)
    {
        if (_isProcessing)
        {
            return;
        }

        _isProcessing = true;
        _targetAdminState = newValue;

        try
        {
            await JS.InvokeVoidAsync("eval", "document.getElementById('toggleAdminSubmitBtn').click()");
        }
        catch
        {
            _isProcessing = false;
        }
    }
}

@page "/User/UserDetail"
@page "/User/UserDetail/{UserId}"
@rendermode InteractiveServer
@namespace SRNSMudApp.Components.User
@using SRNSMudApp.Components.Tag
@using SRNSMudApp.Models

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-10">
    @if (ViewModel.IsLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (ViewModel.User is null)
    {
        <MudAlert Severity="Severity.Error">ユーザーが見つかりませんでした。</MudAlert>
    }
    else
    {
        <div class="d-flex align-center justify-space-between mb-4 flex-wrap gap-4">
            <div class="d-flex align-center gap-3">
                <MudAvatar Color="Color.Primary" Size="Size.Large">
                    @(string.IsNullOrEmpty(ViewModel.User.UserName) ? "?" : ViewModel.User.UserName[0].ToString().ToUpperInvariant())
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h5">@ViewModel.User.UserName</MudText>
                    <div class="d-flex align-center gap-2">
                        @if (ViewModel.User.IsBanned)
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small">利用停止中</MudChip>
                        }
                    </div>
                    <div class="d-flex gap-4 mt-1">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <strong>@ViewModel.FollowingCount</strong> フォロー中
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <strong>@ViewModel.FollowersCount</strong> フォロワー
                        </MudText>
                    </div>
                </div>
            </div>

            @if (ViewModel.CanFollow)
            {
                <MudButton Variant="@(ViewModel.IsFollowing ? Variant.Outlined : Variant.Filled)"
                           Color="@(ViewModel.IsFollowing ? Color.Default : Color.Primary)"
                           StartIcon="@(ViewModel.IsFollowing ? Icons.Material.Filled.PersonRemove : Icons.Material.Filled.PersonAdd)"
                           OnClick="@ToggleFollowAsync">
                    @(ViewModel.IsFollowing ? "フォロー解除" : "フォロー")
                </MudButton>
            }
        </div>

        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" panelClass="pa-4" Class="mt-4"
                 ActivePanelIndex="_activeTabIndex" ActivePanelIndexChanged="OnTabChanged">
            <MudTabPanel Text="アクティビティ (Item & Tag)">
                <SRNSMudApp.Components.UI.ResourceList Tags="ViewModel.UserTags" Items="ViewModel.UserItems" OnDataChanged="ViewModel.LoadDataAsync"
                                                       EnableUrlUpdate="false" />
            </MudTabPanel>
            <MudTabPanel Text="作成したタグツリー">
                <MudCard Elevation="0" Outlined="true">
                    <MudCardContent>
                        @if (ViewModel.UserTags is { Count: > 0 })
                        {
                            <div id="jqtree-container-user-detail" class="tree-container"></div>
                        }
                        else
                        {
                            <MudText>作成したタグはありません。</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudTabPanel>
            <MudTabPanel Text="Reactionタグ">
                @if (ViewModel.ReactionTags.Count > 0)
                {
                    <MudGrid Class="mt-2">
                        @foreach (var tag in ViewModel.ReactionTags)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudCard Outlined="true" Class="rounded-xl h-100 pa-2" Elevation="0">
                                    <MudCardHeader>
                                        <CardHeaderAvatar>
                                            <MudAvatar Color="@GetReactionColor(tag.Name)" Variant="Variant.Filled">
                                                <MudIcon Icon="@GetReactionIcon(tag.Name)" />
                                            </MudAvatar>
                                        </CardHeaderAvatar>
                                        <CardHeaderContent>
                                            <MudText Typo="Typo.h6">@tag.Name</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">リアクションタグ</MudText>
                                        </CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <div class="d-flex align-center justify-space-between mb-2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">累積ウェイト (スコア):</MudText>
                                            <MudChip T="string" Color="@GetReactionColor(tag.Name)" Size="Size.Small" Variant="Variant.Filled">
                                                @tag.CachedWeight
                                            </MudChip>
                                        </div>
                                        @if (!string.IsNullOrEmpty(tag.Content))
                                        {
                                            <MudText Typo="Typo.body2" Class="mt-2 text-muted">@tag.Content</MudText>
                                        }
                                    </MudCardContent>
                                    <MudCardActions>
                                        <MudButton Variant="Variant.Text" Color="@GetReactionColor(tag.Name)"
                                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                                   Href="@($"/TagDetail/{tag.Id}")">
                                            タグ詳細を見る
                                        </MudButton>
                                    </MudCardActions>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else
                {
                    <MudText Color="Color.Secondary" Class="pa-4">Reactionタグはありません。</MudText>
                }
            </MudTabPanel>
            <MudTabPanel Text="@($"フォロー中 ({ViewModel.FollowingCount})")">
                @if (ViewModel.FollowingUsers.Count > 0)
                {
                    <MudList T="ApplicationUser" Clickable="false">
                        @foreach (var followedUser in ViewModel.FollowingUsers)
                        {
                            <MudListItem T="ApplicationUser">
                                <div class="d-flex align-center justify-space-between w-100">
                                    <div class="d-flex align-center gap-3">
                                        <MudAvatar Color="Color.Secondary" Size="Size.Medium">
                                            @(string.IsNullOrEmpty(followedUser.UserName) ? "?" :
                                                followedUser.UserName[0].ToString().ToUpperInvariant())
                                        </MudAvatar>
                                        <div>
                                            <MudLink Href="@($"/User/UserDetail/{followedUser.Id}")" Typo="Typo.subtitle1"
                                                     Color="Color.Primary" Underline="Underline.Hover">
                                                @followedUser.UserName
                                            </MudLink>
                                        </div>
                                    </div>
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                               Href="@($"/User/UserDetail/{followedUser.Id}")">
                                        プロフィール
                                    </MudButton>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                }
                else
                {
                    <MudText Color="Color.Secondary" Class="pa-4">フォローしているユーザーはいません。</MudText>
                }
            </MudTabPanel>
            <MudTabPanel Text="@($"フォロワー ({ViewModel.FollowersCount})")">
                @if (ViewModel.FollowerUsers.Count > 0)
                {
                    <MudList T="ApplicationUser" Clickable="false">
                        @foreach (var follower in ViewModel.FollowerUsers)
                        {
                            <MudListItem T="ApplicationUser">
                                <div class="d-flex align-center justify-space-between w-100">
                                    <div class="d-flex align-center gap-3">
                                        <MudAvatar Color="Color.Secondary" Size="Size.Medium">
                                            @(string.IsNullOrEmpty(follower.UserName) ? "?" :
                                                follower.UserName[0].ToString().ToUpperInvariant())
                                        </MudAvatar>
                                        <div>
                                            <MudLink Href="@($"/User/UserDetail/{follower.Id}")" Typo="Typo.subtitle1"
                                                     Color="Color.Primary" Underline="Underline.Hover">
                                                @follower.UserName
                                            </MudLink>
                                        </div>
                                    </div>
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                               Href="@($"/User/UserDetail/{follower.Id}")">
                                        プロフィール
                                    </MudButton>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                }
                else
                {
                    <MudText Color="Color.Secondary" Class="pa-4">フォロワーはいません。</MudText>
                }
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

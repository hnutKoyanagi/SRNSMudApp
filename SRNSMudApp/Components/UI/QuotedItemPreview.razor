<div class="quoted-item-preview rounded-lg pa-3 my-2 cursor-pointer"
     style="border: 1px solid var(--mud-palette-lines-default); background-color: var(--mud-palette-background-grey);"
     @onclick="HandleClick" @onclick:stopPropagation="true" data-testid="@($"quoted-item-preview-{QuotedItemId}")">
    @if (ViewModel.IsLoading)
    {
        <div class="d-flex align-center gap-2">
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">引用元を読み込み中...</MudText>
        </div>
    }
    else if (ViewModel.TargetItem is not null)
    {
        <div class="d-flex flex-column gap-1">
            <div class="d-flex align-center gap-1">
                <MudIcon Icon="@Icons.Material.Filled.FormatQuote" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.caption" Class="font-weight-bold">
                    @(ViewModel.TargetItem.Owner?.UserName ?? "不明")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-auto">
                    @ViewModel.TargetItem.CreatedDate.ToLocalTime().ToString("g")
                </MudText>
            </div>
            <MudText Typo="Typo.body2" Class="text-truncate line-clamp-2" Style="white-space: pre-wrap;">
                @(string.IsNullOrWhiteSpace(ViewModel.TargetItem.Content) ? "内容なし" : ViewModel.TargetItem.Content)
            </MudText>
        </div>
    }
    else
    {
        <div class="d-flex align-center gap-1">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Default" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                引用元のアイテムは削除されたか、表示できません。
            </MudText>
        </div>
    }
</div>

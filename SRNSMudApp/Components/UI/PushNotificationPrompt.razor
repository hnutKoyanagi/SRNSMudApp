@using MudBlazor
@rendermode InteractiveServer

@if (ViewModel.IsSupported)
{
    @if (ViewModel.Permission == "denied")
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4" Dense="true">
            <div class="d-flex align-center justify-space-between flex-wrap" style="gap: 8px;">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.NotificationsOff" Class="mr-2" Size="Size.Small" />
                    <MudText Typo="Typo.body2">
                        ブラウザの通知がブロックされています。アドレスバーのアイコンから通知を許可してください。
                    </MudText>
                </div>
            </div>
        </MudAlert>
    }
    else if (ViewModel.IsSubscribed && ShowWhenSubscribed)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4" Dense="true">
            <div class="d-flex align-center justify-space-between flex-wrap" style="gap: 8px;">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Class="mr-2" Size="Size.Small" />
                    <MudText Typo="Typo.body2">
                        プッシュ通知は有効です。新しいアクティビティがリアルタイムで届きます。
                    </MudText>
                </div>
                <div class="d-flex align-center" style="gap: 8px;">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               OnClick="SendTestNotificationAsync" Disabled="ViewModel.IsProcessing"
                               StartIcon="@Icons.Material.Filled.Send">
                        テスト通知
                    </MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                               OnClick="UnsubscribeAsync" Disabled="ViewModel.IsProcessing">
                        解除
                    </MudButton>
                </div>
            </div>
        </MudAlert>
    }
    else if (!ViewModel.IsSubscribed)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mb-4" Elevation="2">
            <div class="d-flex align-center justify-space-between flex-wrap" style="gap: 12px;">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.NotificationsNone" Size="Size.Medium" Class="mr-3" />
                    <div>
                        <MudText Typo="Typo.subtitle2" Style="font-weight: bold;">
                            プッシュ通知を有効にする
                        </MudText>
                        <MudText Typo="Typo.caption">
                            タグ付けリクエストや提案などの重要なお知らせをブラウザで受け取れます。
                        </MudText>
                    </div>
                </div>
                <div>
                    <MudButton Variant="Variant.Filled" Color="Color.Surface" Size="Size.Medium"
                               OnClick="RequestPushPermissionAsync" Disabled="ViewModel.IsProcessing"
                               StartIcon="@Icons.Material.Filled.NotificationsActive"
                               Style="font-weight: bold; color: var(--mud-palette-primary);"
                               data-testid="enable-push-notifications-btn">
                        @if (ViewModel.IsProcessing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>処理中...</span>
                        }
                        else
                        {
                            <span>通知を許可する</span>
                        }
                    </MudButton>
                </div>
            </div>
        </MudAlert>
    }
}

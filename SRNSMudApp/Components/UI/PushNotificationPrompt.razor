@using System.Security.Claims
@using Microsoft.JSInterop
@using MudBlazor
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

@if (_isSupported)
{
    @if (_permission == "denied")
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4" Dense="true">
            <div class="d-flex align-center justify-space-between flex-wrap" style="gap: 8px;">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.NotificationsOff" Class="mr-2" Size="Size.Small" />
                    <MudText Typo="Typo.body2">
                        ブラウザの通知がブロックされています。アドレスバーのアイコンから通知を許可してください。
                    </MudText>
                </div>
            </div>
        </MudAlert>
    }
    else if (_isSubscribed && ShowWhenSubscribed)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4" Dense="true">
            <div class="d-flex align-center justify-space-between flex-wrap" style="gap: 8px;">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Class="mr-2" Size="Size.Small" />
                    <MudText Typo="Typo.body2">
                        プッシュ通知は有効です。新しいアクティビティがリアルタイムで届きます。
                    </MudText>
                </div>
                <div class="d-flex align-center" style="gap: 8px;">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               OnClick="SendTestNotificationAsync" Disabled="_isProcessing"
                               StartIcon="@Icons.Material.Filled.Send">
                        テスト通知
                    </MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                               OnClick="UnsubscribeAsync" Disabled="_isProcessing">
                        解除
                    </MudButton>
                </div>
            </div>
        </MudAlert>
    }
    else if (!_isSubscribed)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mb-4" Elevation="2">
            <div class="d-flex align-center justify-space-between flex-wrap" style="gap: 12px;">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.NotificationsNone" Size="Size.Medium" Class="mr-3" />
                    <div>
                        <MudText Typo="Typo.subtitle2" Style="font-weight: bold;">
                            プッシュ通知を有効にする
                        </MudText>
                        <MudText Typo="Typo.caption">
                            タグ付けリクエストや提案などの重要なお知らせをブラウザで受け取れます。
                        </MudText>
                    </div>
                </div>
                <div>
                    <MudButton Variant="Variant.Filled" Color="Color.Surface" Size="Size.Medium"
                               OnClick="RequestPushPermissionAsync" Disabled="_isProcessing"
                               StartIcon="@Icons.Material.Filled.NotificationsActive"
                               Style="font-weight: bold; color: var(--mud-palette-primary);"
                               data-testid="enable-push-notifications-btn">
                        @if (_isProcessing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>処理中...</span>
                        }
                        else
                        {
                            <span>通知を許可する</span>
                        }
                    </MudButton>
                </div>
            </div>
        </MudAlert>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    /// <summary>
    /// 購読済みの場合にもステータスやテスト通知ボタンを表示するかどうか。
    /// </summary>
    [Parameter] public bool ShowWhenSubscribed { get; set; } = true;

    private bool _isSupported = true;
    private string _permission = "default";
    private bool _isSubscribed;
    private bool _isProcessing;
    private string? _userId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadSubscriptionStatusAsync();
        }
    }

    private async Task LoadSubscriptionStatusAsync()
    {
        try
        {
            var authState = await AuthenticationStateTask;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                _userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            }

            var status = await JSRuntime.InvokeAsync<SubscriptionStatusResult>("PushNotificationInterop.getSubscriptionStatus");
            _isSupported = status.Supported;
            _permission = status.Permission;
            _isSubscribed = status.IsSubscribed;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PushNotificationPrompt] Status check error: {ex.Message}");
        }
    }

    /// <summary>
    /// ブラウザの通知許可ダイアログを表示し、VAPID鍵を用いてWeb Pushを購読します。
    /// </summary>
    public async Task RequestPushPermissionAsync()
    {
        _isProcessing = true;

        try
        {
            var subscribeResult = await JSRuntime.InvokeAsync<SubscribeResult>(
                "PushNotificationInterop.enablePushNotifications",
                _userId);

            if (subscribeResult.Success)
            {
                _isSubscribed = true;
                _permission = "granted";
                Snackbar.Add("プッシュ通知を有効化しました！", Severity.Success);
            }
            else
            {
                Snackbar.Add(subscribeResult.Error ?? "通知の許可が得られませんでした。", Severity.Warning);
                await LoadSubscriptionStatusAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"エラーが発生しました: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task UnsubscribeAsync()
    {
        _isProcessing = true;

        try
        {
            var result = await JSRuntime.InvokeAsync<SimpleResult>("PushNotificationInterop.unsubscribe");
            if (result.Success)
            {
                _isSubscribed = false;
                Snackbar.Add("プッシュ通知の購読を解除しました。", Severity.Info);
            }
            else
            {
                Snackbar.Add(result.Error ?? "購読解除に失敗しました。", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"解除中にエラーが発生しました: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task SendTestNotificationAsync()
    {
        _isProcessing = true;

        try
        {
            var result = await JSRuntime.InvokeAsync<SimpleResult>("PushNotificationInterop.sendTestNotification");
            if (result.Success)
            {
                Snackbar.Add(result.Message ?? "テスト通知を送信しました。間もなく届きます。", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Message ?? "テスト通知の送信に失敗しました。", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"送信エラー: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private sealed record SubscriptionStatusResult(bool Supported, string Permission, bool IsSubscribed);
    private sealed record SubscribeResult(bool Success, string? Error, string? Endpoint);
    private sealed record SimpleResult(bool Success, string? Message, string? Error);
}

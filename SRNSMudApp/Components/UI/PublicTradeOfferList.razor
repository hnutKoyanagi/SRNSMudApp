@namespace SRNSMudApp.Components.UI

<MudTable Items="@Offers" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true" Dense="true"
          Class="mt-4">
    <HeaderContent>
        <MudTh>ステータス</MudTh>
        <MudTh>オファー日時</MudTh>
        <MudTh>オファー元</MudTh>
        <MudTh>対象タグ</MudTh>
        <MudTh>要求アセット量</MudTh>
        <MudTh>アクション</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="ステータス">
            @if (context.IsActive)
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small">有効</MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Default" Size="Size.Small">無効</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="オファー日時">@context.CreatedDate.ToLocalTime().ToString("g")</MudTd>
        <MudTd DataLabel="オファー元">@(context.Owner?.UserName ?? "-")</MudTd>
        <MudTd DataLabel="対象タグ">@(context.OfferedTag?.Name ?? "-")</MudTd>
        <MudTd DataLabel="要求アセット量">@context.RequiredAssetAmount</MudTd>
        <MudTd DataLabel="アクション">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" Disabled="!context.IsActive"
                       OnClick="@(() => TriggerOffer(context))">
                受諾する
            </MudButton>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="[10, 20, 50]" />
    </PagerContent>
</MudTable>
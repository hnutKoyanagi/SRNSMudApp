@using SRNSMudApp.Services
@using SRNSMudApp.Components.Item
@using System.Security.Claims
@implements IAsyncDisposable

@* ===== アイテムリスト ===== *@
@if (Items.Any())
{
    <MudStack Spacing="3">
        @foreach (var item in Items)
        {
            <SRNSMudApp.Components.UI.ItemCard Item="@item" AllTags="@ViewModel.AllTags" AllTagRelationsToTags="@ViewModel.AllTagRelationsToTags"
                                               CurrentUserId="@_currentUserId" CurrentUserGoodTagId="@ViewModel.CurrentUserGoodTagId"
                                               CurrentUserBadTagId="@ViewModel.CurrentUserBadTagId" CurrentUserShinjiTagId="@ViewModel.CurrentUserShinjiTagId"
                                               CurrentUserZenTagId="@ViewModel.CurrentUserZenTagId" CurrentUserBiTagId="@ViewModel.CurrentUserBiTagId"
                                               OnEnsureSystemTags="EnsureSystemTagsExistAsync" OnDataChanged="NotifyChangedAsync"
                                               IsFocused="@(_focusItemId == item.Id)" OnFocus="SetFocusItem" EnableNavigation="EnableItemNavigation" />
        }
    </MudStack>
}

@* ===== タグリスト ===== *@
@if (Tags.Any())
{
    <MudStack Spacing="3" Class="@(Items.Any() ? "mt-4" : "")">
        @foreach (var tag in Tags)
        {
            <SRNSMudApp.Components.UI.TagCard Tag="@tag" AllTags="@ViewModel.AllTags" CurrentUserId="@_currentUserId"
                                              CurrentUserGoodTagId="@ViewModel.CurrentUserGoodTagId" CurrentUserBadTagId="@ViewModel.CurrentUserBadTagId"
                                              OnEnsureSystemTags="EnsureSystemTagsExistAsync" OnDataChanged="NotifyChangedAsync"
                                              IsFocused="@(_focusTagId == tag.Id)" OnFocus="SetFocusTag" />
        }
    </MudStack>
}

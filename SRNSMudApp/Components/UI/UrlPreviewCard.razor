@* リンクプレビューの表示専用子コンポーネント。
   プレビューデータの取得は LoadPreview デリゲート経由で親に委譲し、
   本コンポーネントはサービス注入なしでレンダリング可能。
   取得状態は AsyncPageState<LinkPreviewData> union で表現し、
   網羅的パターンマッチングにより描画を決定する (mainRules: if文撲滅)。 *@
@using SRNSMudApp.Components.Tag
@using SRNSMudApp.Models
@namespace SRNSMudApp.Components.UI

@switch (_state)
{
    case Loading when Url.StartsWith("/"):
        <span class="px-1 mx-1 rounded d-inline-flex align-center"
              style="background-color: var(--mud-palette-action-default-hover);">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Style="width: 12px; height: 12px;" Class="mr-1" />
            <MudText Typo="Typo.caption" Class="font-inherit">読込中...</MudText>
        </span>
        break;
    case Loading:
        <MudCard Outlined="true" Class="mt-2 rounded-lg">
            <MudCardContent Class="d-flex align-center pa-2">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-3" />
                <MudText Typo="Typo.body2">リンク情報を取得中...</MudText>
            </MudCardContent>
        </MudCard>
        break;
    case Loaded<LinkPreviewData> loaded when loaded.Data.IsSuccess && Url.StartsWith("/"):
        @if (loaded.Data.Tags is { Count: > 0 })
        {
            <MudTooltip Placement="Placement.Top" Arrow="true">
                <ChildContent>
                    <span @onclick="NavigateToUrl" data-testid="internal-link-preview-pill" class="cursor-pointer px-1 mx-1 rounded"
                          style="background-color: var(--mud-palette-action-default-hover); color: var(--mud-palette-primary);">
                        @(loaded.Data.DisplayText ?? loaded.Data.Description)
                    </span>
                </ChildContent>
                <TooltipContent>
                    <TagBar Tags="@loaded.Data.Tags" />
                </TooltipContent>
            </MudTooltip>
        }
        else
        {
            <span @onclick="NavigateToUrl" data-testid="internal-link-preview-pill" class="cursor-pointer px-1 mx-1 rounded"
                  style="background-color: var(--mud-palette-action-default-hover); color: var(--mud-palette-primary);">
                @(loaded.Data.DisplayText ?? loaded.Data.Description)
            </span>
        }
        break;
    case Loaded<LinkPreviewData> loaded when loaded.Data.IsSuccess:
        <MudCard Outlined="true" Class="mt-2 mb-2 rounded-lg preview-card" @onclick="NavigateToUrl">
            <div class="d-flex flex-row">
                @if (!string.IsNullOrEmpty(loaded.Data.ImageUrl) && !_imageLoadFailed)
                {
                    <div class="preview-img-container">
                        <img src="@loaded.Data.ImageUrl" 
                             alt="Preview Image" 
                             class="preview-img" 
                             style="width: 120px; height: 120px; object-fit: cover;"
                             @onerror="HandleImageError" />
                    </div>
                }
                <MudCardContent Class="pa-3 d-flex flex-column justify-center preview-content">
                    <MudText Typo="Typo.subtitle2" Class="preview-title">
                        @loaded.Data.Title
                    </MudText>
                    @if (!string.IsNullOrEmpty(_selectedText))
                    {
                        <div class="preview-highlight">
                            <div class="d-flex align-center highlight-header">
                                <MudIcon Icon="@Icons.Material.Filled.FormatQuote" Size="Size.Small" Class="highlight-icon" />
                                <MudText Typo="Typo.caption" Class="highlight-title">
                                    選択テキスト
                                </MudText>
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Primary" Class="highlight-text">
                                @_selectedText
                            </MudText>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(loaded.Data.Description))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="preview-description">
                            @loaded.Data.Description
                        </MudText>
                    }
                    <div class="d-flex align-center mt-2">
                        <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Small" Color="Color.Secondary"
                                 Class="mr-1 site-icon" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="site-name">
                            @(!string.IsNullOrEmpty(loaded.Data.SiteName) ? loaded.Data.SiteName : new
                    Uri(loaded.Data.Url).Host)
                        </MudText>
                    </div>
                </MudCardContent>
            </div>
        </MudCard>
        break;
}

@code {
    [Parameter][EditorRequired] public string Url { get; set; } = null!;

    /// <summary>プレビューデータ取得デリゲート（親から注入。null の場合は取得しない）。</summary>
    [Parameter] public Func<string, Task<LinkPreviewData?>>? LoadPreview { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = null!;

    // 取得状態は bool フラグではなく union で表現する (mainRules: 再代入撲滅 / if文撲滅)
    private AsyncPageState<LinkPreviewData> _state = new Loading();
    private string? _selectedText;
    private bool _imageLoadFailed;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(Url))
        {
            return;
        }

        _selectedText = UrlPreviewCardViewModel.ExtractTextFragment(Url);

        if (LoadPreview is null)
        {
            _state = new Empty("プレビュー取得デリゲート未設定");
            return;
        }

        _state = new Loading();
        LinkPreviewData? preview = await LoadPreview(Url);

        _state = preview is { IsSuccess: true }
            ? new Loaded<LinkPreviewData>(preview)
            : new Empty("プレビューを取得できませんでした");
    }

    private void HandleImageError()
    {
        _imageLoadFailed = true;
    }

    private async Task NavigateToUrl()
    {
        if (!string.IsNullOrEmpty(Url))
        {
            try
            {
                await JS.InvokeVoidAsync("open", Url, "_blank");
            }
            catch (Exception)
            {
                // ignored
            }
        }
    }
}

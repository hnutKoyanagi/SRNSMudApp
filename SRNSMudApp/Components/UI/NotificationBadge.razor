@implements IDisposable

@if (ViewModel.CurrentUserId is not null)
{
    <MudBadge Content="ViewModel.UnreadCount" Color="Color.Error" Overlap="true" Visible="@ViewModel.IsVisible"
              data-testid="appbar-notifications-badge">
        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" Href="notifications"
                       aria-label="notifications" />
    </MudBadge>
}

@using System.Security.Claims
@using SRNSMudApp.Services
@inject IItemReplyService ItemReplyService
@inject IHomeDataProvider HomeData
@inject ITaggingRequestActions RequestActions
@inject IDialogLauncher DialogLauncher


<MudDialog>
    <DialogContent>
        <div class="d-flex flex-column pa-2" style="max-height: 50vh; overflow-y: auto;">

            @if (CanApprove(TaggingRequest))
            {
                <div class="d-flex justify-end mb-2">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               OnClick="ApproveRequestAsync" Class="mr-2">
                        承認
                    </MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.ThumbDown" OnClick="RejectRequestAsync">
                        却下
                    </MudButton>
                </div>
            }

            <!-- 親リクエスト (スレッドの開始点) -->
            @if (TaggingRequest.RequestItem is not null)
            {
                <div class="mb-4">
                    <ItemCard Item="TaggingRequest.RequestItem" CurrentUserId="@_currentUserId" AllTags="_allTags"
                              AllTagRelationsToTags="_allTagRelationsToTags" />
                </div>
            }
            else
            {
                <div class="d-flex mb-1">
                    <MudAvatar Size="Size.Medium" Class="mr-3" Color="Color.Primary">
                        @(TaggingRequest.Owner?.UserName?.FirstOrDefault().ToString() ?? "?")
                    </MudAvatar>
                    <div class="flex-grow-1">
                        <div class="d-flex align-baseline">
                            <MudText Typo="Typo.subtitle2" Class="mr-2">
                                <b>@TaggingRequest.Owner?.UserName</b>
                            </MudText>
                            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                                @TaggingRequest.CreatedDate.ToLocalTime().ToString("g")
                            </MudText>
                        </div>
                        <MudText Typo="Typo.body1" Class="mt-1">
                            @if (TaggingRequest.RequestType == TaggingRequestType.Add)
                            {
                                <span>このアイテムに <b>@TaggingRequest.RequestedTag?.Name</b> を追加するリクエストをしました。</span>
                            }
                            else
                            {
                                <span>このアイテムから <b>@TaggingRequest.RequestedTag?.Name</b> を削除するリクエストをしました。</span>
                            }
                        </MudText>
                    </div>
                </div>
            }

            <!-- リプライツリー -->
            <div class="ml-5 pl-5" style="border-left: 2px solid var(--mud-palette-lines-default);">
                @if (Replies.Count > 0)
                {
                    @foreach (var reply in Replies)
                    {
                        <div class="mb-4 mt-3 position-relative">
                            <div class="position-absolute" style="left: -30px; top: 10px; z-index: 1;">
                                <MudAvatar Size="Size.Small" Style="border: 3px solid var(--mud-palette-background);"
                                           Color="Color.Secondary">
                                    @(reply.Owner?.UserName?.FirstOrDefault().ToString() ?? "?")
                                </MudAvatar>
                            </div>
                            <div class="flex-grow-1">
                                <ItemCard Item="reply" CurrentUserId="@_currentUserId" AllTags="_allTags"
                                          AllTagRelationsToTags="_allTagRelationsToTags" />
                            </div>
                        </div>
                    }
                }
            </div>

        </div>
    </DialogContent>

    <DialogActions>
        <!-- 新規リプライ投稿フィールド -->
        <div class="d-flex w-100 px-4 pb-2 align-center">
            <MudTextField @bind-Value="_newReplyMessage" Placeholder="返信を投稿..." Variant="Variant.Outlined"
                          Margin="Margin.Dense" Class="mr-2" Immediate="true" Lines="1" MaxLines="3" />
            <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary" AriaLabel="Send"
                           OnClick="SubmitReplyAsync" Disabled="@(string.IsNullOrWhiteSpace(_newReplyMessage) || _isSubmitting)" />
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public TaggingRequestEntity TaggingRequest { get; set; } = null!;

    private List<Item> Replies { get; set; } = [];
    private string _newReplyMessage = string.Empty;
    private bool _isSubmitting;
    private string? _currentUserId;
    private List<Tag> _allTags = [];
    private List<TagRelationToTag> _allTagRelationsToTags = [];

    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // パラメータとして渡されたリクエストの既存リプライをセット
        Replies = TaggingRequest.Replies?.OrderBy(r => r.CreatedDate).ToList() ?? [];

        var authState = await AuthenticationStateTask;
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _currentUserId = user.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
        }

        (List<Tag> allTags, List<TagRelationToTag> relations) = await HomeData.GetTagsAndRelationsAsync();
        _allTags = allTags;
        _allTagRelationsToTags = relations;
    }

    private async Task SubmitReplyAsync()
    {
        if (string.IsNullOrWhiteSpace(_newReplyMessage) || string.IsNullOrEmpty(_currentUserId))
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            var newReply = await ItemReplyService.AddReplyToRequestAsync(TaggingRequest.Id, _currentUserId, _newReplyMessage);
            if (newReply is not null)
            {
                Replies.Add(newReply);
                _newReplyMessage = string.Empty;

                if (!TaggingRequest.Replies.Contains(newReply))
                {
                    TaggingRequest.Replies.Add(newReply);
                }
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private bool CanApprove(TaggingRequestEntity request)
    {
        return RequestActions.CanApprove(request, _currentUserId);
    }

    private async Task ApproveRequestAsync()
    {
        if (_currentUserId is null)
        {
            return;
        }

        if (await RequestActions.ApproveAsync(TaggingRequest.Id, _currentUserId))
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private async Task RejectRequestAsync()
    {
        if (_currentUserId is null)
        {
            return;
        }

        if (await RequestActions.RejectViaDialogAsync(TaggingRequest.Id, _currentUserId))
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

}
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@rendermode InteractiveServer

@namespace SRNSMudApp.Components.Item

@using SRNSMudApp.Components.UI
@using SRNSMudApp.Services
@implements IAsyncDisposable
@inject IItemCardDataProvider ItemCardData
@inject IUserGroupDataProvider UserGroupData
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IUserDataProvider UserDataProvider
@inject ILinkPreviewService PreviewService
@inject ITagSearchQueryService TagSearchQueryService
@inject IJSRuntime JS
@inject ILogger<AddItem> Logger
@using SRNSMudApp.Models
@inject IItemReplyService ItemReplyService

<MudStack Class="w-100 pb-2">
    @switch (_newItem)
    {
        case null:
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText>読み込み中...</MudText>
            break;
        case not null:
            <EditForm Model="@_newItem" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit"
                      FormName="AddItem" class="w-100">
                <DataAnnotationsValidator />

                <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Start">
                    <MudStack Class="flex-grow-1" Style="min-width: 0;">
                        @{
                            var allUrls = ItemCardViewModel.ExtractUrls(_newItem.Content);
                            var externalUrls = allUrls.Where(u => !u.StartsWith("/")).ToList();
                        }
                        <div class="add-item-editor-container" onclick="document.getElementById('add-item-textarea')?.focus()">
                            @* リンクプレビュー（pill）をインライン表示可能な contenteditable エディタ *@
                            <div id="add-item-textarea" class="add-item-editor" contenteditable="true" role="textbox"
                                 aria-multiline="true" data-placeholder="新しいアイテムのコンテンツを入力..."></div>

                            @* bUnit テストおよびフォーム同期用の textarea（テスト・バリデーション互換性を維持） *@
                            <textarea id="add-item-textarea-hidden" name="_newItem.Content" class="add-item-hidden-textarea"
                                      value="@_newItem.Content"
                                      @oninput="@(async (ChangeEventArgs e) => await HandleContentChanged(e.Value?.ToString() ?? string.Empty))"
                                      @onkeydown="@HandleKeyDown"></textarea>
                        </div>
                        <div class="d-flex justify-space-between align-center px-1 mt-1">
                            <ValidationMessage For="@(() => _newItem.Content)" />
                            <MudText Typo="Typo.caption"
                                     Color="@(_newItem.Content?.Length > 1000 ? Color.Error : Color.Default)">
                                @($"{_newItem?.Content?.Length ?? 0} / 1000")
                            </MudText>
                        </div>

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Class="mt-1">
                            <MudSwitch @bind-Value="_isPrivate" Color="Color.Primary" Label="プライベートモード" Size="Size.Small" />

                            @if (_isPrivate)
                            {
                                <MudSelect T="int?" @bind-Value="_selectedGroupId" Label="公開範囲" Dense="true" Margin="Margin.Dense"
                                           Variant="Variant.Outlined" Style="max-width: 250px;">
                                    <MudSelectItem T="int?" Value="@((int?)null)">フォロワーのみ（デフォルト）</MudSelectItem>
                                    @foreach (var group in _userGroups ?? [])
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)group.Id)">@group.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                        </MudStack>

                        @if (_targetCandidates.Count > 0)
                        {
                            <MudExpansionPanels Class="mt-2" Elevation="0" Outlined="true">
                                <MudExpansionPanel Text="@($"通知先 ({_selectedTargetUserIds.Count})")" Dense="true">
                                    <div class="d-flex flex-wrap align-center gap-2 px-1">
                                        @foreach (var candidate in _targetCandidates)
                                        {
                                            var isChecked = _selectedTargetUserIds.Contains(candidate.Id);
                                            <div class="d-inline-flex align-center">
                                                <MudCheckBox T="bool" Value="@isChecked"
                                                             ValueChanged="@((bool val) => HandleTargetToggled(candidate.Id, val))" Dense="true"
                                                             Size="Size.Small" Color="Color.Primary">
                                                    <MudText Typo="Typo.caption">@candidate.UserName</MudText>
                                                </MudCheckBox>
                                            </div>
                                        }
                                    </div>
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        }

                        @* 外部URLのプレビューカードのみ別セクションに表示 *@
                        @switch (externalUrls.Count > 0)
                        {
                            case true:
                                <MudStack Spacing="2" Class="mt-2">
                                    @foreach (var url in externalUrls.Take(3))
                                    {
                                        <SRNSMudApp.Components.UI.UrlPreviewCard Url="@url" LoadPreview="@PreviewService.GetPreviewAsync" />
                                    }
                                </MudStack>
                                break;
                        }
                    </MudStack>

                    <MudStack AlignItems="AlignItems.Center" Class="mt-2" Style="min-width: 90px;">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Large" Class="w-100">
                            保存
                        </MudButton>
                    </MudStack>
                </MudStack>
            </EditForm>
            break;
    }
</MudStack>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    [Parameter] public IEnumerable<Data.Tag> InitialTags { get; set; } = [];

    [Parameter] public EventCallback OnItemAdded { get; set; }

    [SupplyParameterFromForm] private Data.Item? _newItem { get; set; }

    private bool _isPrivate;
    private List<ReplyTargetCandidate> _targetCandidates = [];
    private HashSet<string> _selectedTargetUserIds = [];
    private bool _hasManuallyModifiedTargets = false;
    private HashSet<string> _unselectedTargetUserIds = [];
    private int? _selectedGroupId;
    private IReadOnlyList<Data.UserGroup> _userGroups = [];

    protected override async Task OnInitializedAsync()
    {
        // 2. フォーム送信時（POST）の再読み込みで、入力済みデータを上書きしないようにガードする
        switch (_newItem)
        {
            case null:
                var authState = await AuthenticationStateTask;
                var user = authState.User;

                var userId = string.Empty;

                switch (user.Identity is not null && user.Identity.IsAuthenticated)
                {
                    case true:
                        userId = user.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
                        if (!string.IsNullOrEmpty(userId))
                        {
                            _userGroups = await UserGroupData.GetUserGroupsForUserAsync(userId);
                            var appUser = await UserDataProvider.FindUserByIdAsync(userId);
                            if (appUser != null && appUser.IsPrivateModeDefault)
                            {
                                _isPrivate = true;
                                _selectedGroupId = appUser.DefaultPrivateUserGroupId;
                            }
                        }
                        break;
                }

                _newItem = new Data.Item
                {
                    Content = string.Empty,
                    OwnerId = userId,
                    IsPrivate = _isPrivate,
                    TargetUserGroupId = _selectedGroupId
                };
                break;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (string.IsNullOrWhiteSpace(_newItem!.Content))
        {
            return;
        }

        try
        {
            _newItem.IsPrivate = _isPrivate;
            _newItem.TargetUserGroupId = _isPrivate ? _selectedGroupId : null;
            
            if (_selectedTargetUserIds.Count > 0)
            {
                _newItem.NotificationRecipients = _selectedTargetUserIds.Select(id => new Data.ItemReplyNotificationRecipient
                {
                    RecipientUserId = id,
                    CreatedDate = DateTimeOffset.UtcNow
                }).ToList();
            }

            await ItemCardData.CreateItemAsync(
                _newItem, InitialTags?.Select(t => t.Id).ToList());

            _newItem = new Data.Item
            {
                Content = string.Empty,
                OwnerId = _newItem.OwnerId,
                IsPrivate = _isPrivate,
                TargetUserGroupId = _isPrivate ? _selectedGroupId : null
            };

            try
            {
                await JS.InvokeVoidAsync("tributeInterop.clear", "add-item-textarea");
            }
            catch (Exception)
            {
                // ignored
            }

            Snackbar.Add("アイテムが正常に保存されました。", Severity.Success);

            if (OnItemAdded.HasDelegate)
            {
                await OnItemAdded.InvokeAsync();
            }
            else
            {
                NavigationManager.NavigateTo(NavigationManager.Uri, true);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"エラー: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.MetaKey)
        {
            await HandleValidSubmit();
        }
    }

    private void HandleInvalidSubmit(EditContext context)
    {
        Snackbar.Add("入力内容を確認してください。", Severity.Warning);
    }
    
    private async Task HandleContentChanged(string value)
    {
        _newItem!.Content = value;
        await UpdateTargetCandidatesAsync();
    }
    
    private void HandleTargetToggled(string userId, bool isSelected)
    {
        _hasManuallyModifiedTargets = true;
        if (isSelected)
        {
            _selectedTargetUserIds.Add(userId);
            _unselectedTargetUserIds.Remove(userId);
        }
        else
        {
            _selectedTargetUserIds.Remove(userId);
            _unselectedTargetUserIds.Add(userId);
        }
    }
    
    private async Task UpdateTargetCandidatesAsync()
    {
        if (string.IsNullOrWhiteSpace(_newItem?.Content))
        {
            _targetCandidates.Clear();
            _selectedTargetUserIds.Clear();
            return;
        }
        
        var urls = ItemCardViewModel.ExtractUrls(_newItem.Content);
        var userIdsInText = urls
            .Where(u => u.StartsWith("/User/UserDetail/"))
            .Select(u => u.Substring("/User/UserDetail/".Length))
            .Distinct()
            .ToList();
            
        var authState = await AuthenticationStateTask;
        var currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        
        // Remove current user
        if (!string.IsNullOrEmpty(currentUserId))
        {
            userIdsInText.Remove(currentUserId);
        }
        
        if (userIdsInText.Count == 0)
        {
            _targetCandidates.Clear();
            _selectedTargetUserIds.Clear();
            return;
        }
        
        var users = await UserDataProvider.GetUsersByIdsAsync(userIdsInText);
        
        _targetCandidates = (users ?? []).Select(u => new ReplyTargetCandidate(u.Id, u.UserName!)).ToList();
        
        // Update selected states
        foreach (var candidate in _targetCandidates)
        {
            if (_hasManuallyModifiedTargets)
            {
                if (_unselectedTargetUserIds.Contains(candidate.Id))
                {
                    _selectedTargetUserIds.Remove(candidate.Id);
                }
                else
                {
                    _selectedTargetUserIds.Add(candidate.Id);
                }
            }
            else
            {
                // Default: selected
                _selectedTargetUserIds.Add(candidate.Id);
            }
        }
    }

    // --- JS Interop Mentions Logic ---

    private DotNetObjectReference<AddItem>? _objRef;
    private bool _tributeInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_tributeInitialized && _newItem != null)
        {
            _tributeInitialized = true;
            _objRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("tributeInterop.init", "add-item-textarea", _objRef);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "JS Interop Error while initializing Tribute: {Message}", ex.Message);
            }
        }
    }

    public record MentionItem(string name, string replacement);

    [JSInvokable]
    public async Task<IEnumerable<MentionItem>> SearchTags(string query)
    {
        
        var tags = await TagSearchQueryService.SearchTagsWithFallbackAsync(query);
        return tags.Select(t => new MentionItem("#" + t.Name, $"/TagDetail/{t.Id}"));
    }

    [JSInvokable]
    public async Task<IEnumerable<MentionItem>> SearchUsers(string query)
    {
        var users = await UserDataProvider.SearchUsersAsync(query);
        return users.Select(u => new MentionItem("@" + u.UserName, $"/User/UserDetail/{u.Id}"));
    }

    [JSInvokable]
    public async Task SubmitForm()
    {
        await HandleValidSubmit();
    }

    public async ValueTask DisposeAsync()
    {
        if (_objRef != null)
        {
            try { await JS.InvokeVoidAsync("tributeInterop.destroy", "add-item-textarea"); } catch { }
            _objRef.Dispose();
        }
    }
}
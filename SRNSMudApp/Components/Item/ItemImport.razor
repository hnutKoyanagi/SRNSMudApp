@using System.Security.Claims
@rendermode InteractiveServer

@using SRNSMudApp.Models.Unions
@using SRNSMudApp.Services
@inject ItemImportViewModel ViewModel
@inject ISnackbar Snackbar

<MudPaper Outlined="true" Class="pa-4 rounded-xl mb-4">
    <MudStack>
        <MudText Typo="Typo.h6">CSVからインポート</MudText>
        <MudText Typo="Typo.body2">フォーマット: 1列目にアイテムのContent、2列目以降にタグ名を指定します。</MudText>
        <InputFile id="csv-upload" OnChange="@OnCsvUpload" hidden accept=".csv" />
        <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.UploadFile" for="csv-upload" Disabled="@ViewModel.IsUploading">
            @if (ViewModel.IsUploading)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">処理中...</MudText>
            }
            else
            {
                <MudText>CSVファイルを選択</MudText>
            }
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    [Parameter] public EventCallback OnImportCompleted { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var authState = await AuthState;
            ViewModel.CurrentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        }
    }

    private async Task OnCsvUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > ItemImportViewModel.MaxFileSizeBytes)
        {
            Snackbar.Add("ファイルサイズが大きすぎます。5MB以下のファイルを選択してください。", Severity.Error);
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(ItemImportViewModel.MaxFileSizeBytes);
            var result = await ViewModel.ImportCsvAsync(stream, file.Size);

            if (result is Success<int> s)
            {
                Snackbar.Add($"{s.Value}件のアイテムをインポートしました。", Severity.Success);
                await OnImportCompleted.InvokeAsync();
            }
            else if (result is Failure f)
            {
                var severity = f.ErrorMessage.Contains("ありませんでした") ? Severity.Info : Severity.Error;
                Snackbar.Add(f.ErrorMessage, severity);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"エラーが発生しました: {ex.Message}", Severity.Error);
        }
    }
}
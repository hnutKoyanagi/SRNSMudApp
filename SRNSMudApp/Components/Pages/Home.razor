@page "/"
@using System.Security.Claims
@using SRNSMudApp.Components.UI

@rendermode InteractiveServer
@inject HomeViewModel ViewModel
@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    @if (ViewModel.IsLoggedIn)
    {
        <PushNotificationPrompt ShowWhenSubscribed="false" />
        <MudText Typo="Typo.h5" GutterBottom="true" Class="mb-4">タイムライン</MudText>

        @if (ViewModel.FollowedTagIds is { Count: 0 })
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                まだタグをフォローしていません。タグをフォローすると、ここにタイムラインが表示されます。
            </MudAlert>
        }
        else if (ViewModel.FollowedTagIds is not null)
        {
            <div style="height: 80vh; overflow-y: auto;">
                <Virtualize ItemsProvider="LoadTimeline" Context="group" ItemComparer="new TimelineFeedGroupComparer()">
                    <ItemContent>
                        <div class="mb-4">
                            @{
                                var target =
                    System.Text.Json.JsonSerializer.Deserialize<SRNSMudApp.Models.Unions.TimelineTarget>(group.TimelineTargetJson);
                            }
                            @if (target is SRNSMudApp.Models.Unions.ItemTarget && group.Item is not null)
                            {
                                <SRNSMudApp.Components.UI.ItemCard Item="@group.Item" AllTags="@ViewModel.AllTags"
                                                                   AllTagRelationsToTags="@ViewModel.AllTagRelationsToTags" CurrentUserId="@ViewModel.CurrentUserId"
                                                                   CurrentUserGoodTagId="@ViewModel.CurrentUserGoodTagId" CurrentUserBadTagId="@ViewModel.CurrentUserBadTagId"
                                                                   CurrentUserShinjiTagId="@ViewModel.CurrentUserShinjiTagId" CurrentUserZenTagId="@ViewModel.CurrentUserZenTagId"
                                                                   CurrentUserBiTagId="@ViewModel.CurrentUserBiTagId" OnEnsureSystemTags="ViewModel.EnsureSystemTagsExistAsync"
                                                                   HighlightEvents="@group.Events" IsFocused="false" />
                            }
                            else if (target is SRNSMudApp.Models.Unions.TagTarget && group.Tag is not null)
                            {
                                <SRNSMudApp.Components.UI.TagCard Tag="@group.Tag" AllTags="@ViewModel.AllTags"
                                                                  CurrentUserId="@ViewModel.CurrentUserId" CurrentUserGoodTagId="@ViewModel.CurrentUserGoodTagId"
                                                                  CurrentUserBadTagId="@ViewModel.CurrentUserBadTagId" OnEnsureSystemTags="ViewModel.EnsureSystemTagsExistAsync"
                                                                  HighlightEvents="@group.Events" IsFocused="false" />
                            }
                        </div>
                    </ItemContent>
                    <Placeholder>
                        <MudCard Class="mb-4" Elevation="0" Outlined="true">
                            <MudCardContent>
                                <div class="d-flex justify-center align-center py-4">
                                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                                </div>
                            </MudCardContent>
                        </MudCard>
                    </Placeholder>
                </Virtualize>
            </div>
        }
    }
    else
    {
        <MudText Typo="Typo.h3" GutterBottom="true" Align="Align.Center" Class="mt-10">Welcome to SRNSMudApp</MudText>
        <MudText Align="Align.Center" Class="mb-8">
            ログインして、フォローしたタグのタイムラインを表示しましょう。
        </MudText>
        <div class="d-flex justify-center">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/Account/Login" Size="Size.Large">
                ログイン
            </MudButton>
        </div>
    }
</MudContainer>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        await ViewModel.InitializeAsync(authState.User);
    }

    private async ValueTask<ItemsProviderResult<TimelineFeedGroup>> LoadTimeline(ItemsProviderRequest request)
    {
        var (groups, totalCount) = await ViewModel.LoadTimelineAsync(request.StartIndex, request.Count);
        return new ItemsProviderResult<TimelineFeedGroup>(groups, totalCount);
    }
}
@page "/auth/callback"
@using Microsoft.AspNetCore.WebUtilities
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject ILogger<AuthCallback> Logger
<PageTitle>Authenticating...</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 text-center">
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    <MudText Typo="Typo.h6" Class="mt-4">Completing authentication...</MudText>
</MudContainer>

@code {

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
            var query = QueryHelpers.ParseQuery(uri.Query);

            if (query.TryGetValue("code", out var code) && query.TryGetValue("provider", out var provider))
            {
                Logger.LogInformation("AuthCallback invoked with provider={Provider}", provider);

                // Call the JS function to post the code to our backend
                try
                {
                    try
                    {
                        await JS.InvokeVoidAsync("customAuth.loginWithToken", provider.ToString(), code.ToString());
                    }
                    catch (JSException)
                    {
                        NavigationManager.NavigateTo("/Account/Login");
                    }
                    Logger.LogInformation("LoginWithToken JS invocation completed");
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "JS interop error during AuthCallback");
                    NavigationManager.NavigateTo("/Account/Login");
                }
            }
            else
            {
                Logger.LogWarning("Missing code or provider in query. Query: {Query}", uri.Query);

                NavigationManager.NavigateTo("/Account/Login");
            }
        }
    }

}
@using System.Security.Claims
@using SRNSMudApp.Services
@using SRNSMudApp.Models.Unions
@inject FulfillBountyViewModel ViewModel
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" GutterBottom="true">
            以下のアイテムにタグ付けを行って依頼を完了します。
        </MudText>
        <MudList T="string" ReadOnly="true">
            <MudListItem>
                <MudText Typo="Typo.subtitle2">対象アイテム</MudText>
                <MudText Typo="Typo.body2">@Bounty.TargetItem.Content</MudText>
            </MudListItem>
            <MudListItem>
                <MudText Typo="Typo.subtitle2">付与するタグ</MudText>
                <MudText Typo="Typo.body2">@Bounty.RequestedTag.Name</MudText>
            </MudListItem>
            @if (ViewModel.OfferedRewardAsset is not null)
            {
                <MudListItem>
                    <MudText Typo="Typo.subtitle2">獲得できる報酬</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Success">
                        @($"[ID: {ViewModel.OfferedRewardAsset.Id}] {ViewModel.OfferedRewardAsset.TargetTag?.Name} の権利")
                    </MudText>
                </MudListItem>
            }
        </MudList>

        @if (ViewModel.IsLoading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (ViewModel.CanFulfillAsOwner)
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">
                あなたはタグ「@Bounty.RequestedTag.Name」のオーナーです。アセットを消費せずに依頼を完了できます。
            </MudAlert>
        }
        else if (ViewModel.MyValidAssets.Any())
        {
            <MudForm @ref="_form" @bind-IsValid="@_isValid">
                <MudSelect T="RightAsset" Label="消費するアセットを選択" @bind-Value="ViewModel.SelectedAsset" Required="true"
                           RequiredError="消費するアセットを選択してください"
                           ToStringFunc="@(a => a?.TargetTag?.Name != null ? $"[ID: {a.Id}] {a.TargetTag.Name} の権利" : "")"
                           Class="mt-4">
                    @foreach (var asset in ViewModel.MyValidAssets)
                    {
                        <MudSelectItem Value="@asset" />
                    }
                </MudSelect>
            </MudForm>
        }
        else
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">
                この依頼を完了するために必要な「@Bounty.RequestedTag.Name」の権利（RightAsset）を所持していません。
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!CanSubmit())">
            依頼を完了
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    [Parameter] public TaggingRequestEntity Bounty { get; set; } = null!;

    private MudForm? _form;
    private bool _isValid;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        var currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        await ViewModel.InitializeAsync(Bounty, currentUserId);
    }

    private bool CanSubmit()
    {
        if (ViewModel.IsLoading)
        {
            return false;
        }

        return ViewModel.CanFulfillAsOwner || (ViewModel.MyValidAssets.Any() && ViewModel.SelectedAsset is not null && _isValid);
    }

    private async Task Submit()
    {
        if (!CanSubmit())
        {
            return;
        }

        if (!ViewModel.CanFulfillAsOwner)
        {
            await _form!.ValidateAsync();
            if (!_isValid)
            {
                return;
            }
        }

        var result = await ViewModel.SubmitAsync();
        switch (result)
        {
            case Success<string>:
                Snackbar.Add("依頼を完了しました！", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                break;
            case Failure fail:
                Snackbar.Add($"エラーが発生しました: {fail.ErrorMessage}", Severity.Error);
                break;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
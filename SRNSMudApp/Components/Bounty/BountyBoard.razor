@page "/Bounty/BountyBoard"
@using System.Security.Claims
@rendermode InteractiveServer

@attribute [Authorize]

@using SRNSMudApp.Services
@inject BountyBoardViewModel ViewModel
@inject IDialogLauncher DialogLauncher
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true">Bounty Board</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">
        他のユーザーが「このアイテムにタグをつけてほしい！」と依頼しているリストです。条件を満たせば依頼を完了して報酬を受け取ることができます。
    </MudText>

    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog" Class="mb-6">
        タグ付けを依頼する
    </MudButton>

    @if (ViewModel.IsLoading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!ViewModel.Bounties.Any())
    {
        <MudAlert Severity="Severity.Info">現在、募集中のバウンティはありません。</MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var bounty in ViewModel.Bounties)
            {
                <MudItem xs="12" sm="6" md="4" @key="bounty.Id">
                    <MudCard Elevation="3">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@bounty.RequestedTag.Name</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    依頼者: @bounty.RequesterUserId
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle2">対象アイテム</MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">@bounty.TargetItem.Content</MudText>

                            @{
                                RightAsset? rewardAsset = ViewModel.ResolveRewardAsset(bounty);
                            }
                            @if (rewardAsset is not null)
                            {
                                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-2 py-1 px-2"
                                          Style="font-size: 0.8rem;">
                                    報酬: @rewardAsset.TargetTag?.Name の権利
                                </MudAlert>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">（無償のウィッシュリスト）</MudText>
                            }
                        </MudCardContent>
                        <MudCardActions>
                            @if (!ViewModel.CanFulfillBounty(bounty))
                            {
                                <MudButton Disabled="true" Variant="Variant.Text">自分の依頼</MudButton>
                            }
                            else
                            {
                                <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="() => FulfillBounty(bounty)">
                                    依頼を完了する
                                </MudButton>
                            }
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        ViewModel.CurrentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        await ViewModel.LoadDataAsync();
    }

    private async Task OpenCreateDialog()
    {
        var options = BountyBoardViewModel.CreateDialogOptions();
        var dialog = await DialogLauncher.ShowAsync<BountyCreateDialog>("タグ付けの依頼を作成", options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await ViewModel.LoadDataAsync();
        }
    }

    private async Task FulfillBounty(TaggingRequestEntity bounty)
    {
        var parameters = BountyBoardViewModel.FulfillDialogParameters(bounty);
        var options = BountyBoardViewModel.FulfillDialogOptions();
        var dialog = await DialogLauncher.ShowAsync<FulfillBountyDialog>("依頼を叶える", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await ViewModel.LoadDataAsync();
        }
    }
}
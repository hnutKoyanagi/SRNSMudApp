@page "/Admin/Invitations"
@using System.Security.Claims

@attribute [Authorize(Roles = "Admin")]
@using SRNSMudApp.Services
@inject IAdminDataProvider AdminData
@inject ISnackbar Snackbar

<PageTitle>Invitation Management</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Invitation Management</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h6">Create New Invitation</MudText>
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudTextField @bind-Value="_newEmail" Label="Invitee Email Address" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateInvitation"
                       DisableElevation="true">
                Generate Invite Link
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="@_invitations" Hover="true" Dense="true" Elevation="1">
    <HeaderContent>
        <MudTh>Email</MudTh>
        <MudTh>Code</MudTh>
        <MudTh>Expiration</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Action</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Email">@context.Email</MudTd>
        <MudTd DataLabel="Code">
            <MudTooltip Text="Copy Link">
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                               OnClick="@(() => CopyLink(context.InvitationCode))" />
            </MudTooltip>
            @context.InvitationCode
        </MudTd>
        <MudTd DataLabel="Expiration">@context.ExpirationDate.ToLocalTime().ToString("g")</MudTd>
        <MudTd DataLabel="Status">
            @{
                var status = InvitationManagerViewModel.GetInvitationStatus(context, DateTime.UtcNow);
            }
            <MudChip T="string" Color="@InvitationManagerViewModel.GetStatusColor(status)" Size="Size.Small">
                @InvitationManagerViewModel.GetStatusText(status)
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Action">
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                           OnClick="@(() => DeleteInvitation(context))" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private string _newEmail = "";
    private List<Invitation> _invitations = [];
    private string? _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        _currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        await LoadInvitations();
    }

    private async Task LoadInvitations()
    {
        _invitations = await AdminData.GetInvitationsAsync();
    }

    private async Task CreateInvitation()
    {
        if (string.IsNullOrWhiteSpace(_newEmail))
        {
            Snackbar.Add("Email is required.", Severity.Error);
            return;
        }

        var code = InvitationManagerViewModel.GenerateRandomCode(16);
        var invitation = new Invitation
        {
            Email = _newEmail,
            InvitationCode = code,
            ExpirationDate = DateTime.UtcNow.AddDays(7), // 7 days expiration
            IsUsed = false,
            InvitedByAdminId = _currentUserId ?? string.Empty,
            OwnerId = _currentUserId ?? "system"
        };

        await AdminData.CreateInvitationAsync(invitation);

        Snackbar.Add("Invitation created successfully.", Severity.Success);
        _newEmail = "";
        await LoadInvitations();
    }

    private async Task DeleteInvitation(Invitation invitation)
    {
        await AdminData.DeleteInvitationAsync(invitation);
        Snackbar.Add("Invitation deleted.", Severity.Info);
        await LoadInvitations();
    }

    // This method simulates copying to clipboard. In a real app, use JSInterop.
    private void CopyLink(string code)
    {
        // For simplicity, just show snackbar. JS interop needed for real clipboard copy.
        Snackbar.Add($"Link to copy: /Account/Login?inviteCode={code}", Severity.Info);
    }
}
@page "/Admin/Invitations"
@using System.Security.Claims
@attribute [Authorize(Roles = "Admin")]
@using SRNSMudApp.Models.Unions
@inject InvitationManagerViewModel ViewModel
@inject ISnackbar Snackbar

<PageTitle>Invitation Management</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Invitation Management</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h6">Create New Invitation</MudText>
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudTextField @bind-Value="ViewModel.NewEmail" Label="Invitee Email Address" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateInvitationAsync"
                       Disabled="ViewModel.IsProcessing" DisableElevation="true">
                Generate Invite Link
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="@ViewModel.Invitations" Hover="true" Dense="true" Elevation="1">
    <HeaderContent>
        <MudTh>Email</MudTh>
        <MudTh>Code</MudTh>
        <MudTh>Expiration</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Action</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Email">@context.Email</MudTd>
        <MudTd DataLabel="Code">
            <MudTooltip Text="Copy Link">
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                               OnClick="@(() => CopyLink(context.InvitationCode))" />
            </MudTooltip>
            @context.InvitationCode
        </MudTd>
        <MudTd DataLabel="Expiration">@context.ExpirationDate.ToLocalTime().ToString("g")</MudTd>
        <MudTd DataLabel="Status">
            @{
                var status = InvitationManagerViewModel.GetInvitationStatus(context, DateTime.UtcNow);
            }
            <MudChip T="string" Color="@InvitationManagerViewModel.GetStatusColor(status)" Size="Size.Small">
                @InvitationManagerViewModel.GetStatusText(status)
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Action">
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                           OnClick="@(() => DeleteInvitationAsync(context))" Disabled="ViewModel.IsProcessing" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            ViewModel.Initialize(authState.User);
        }

        await ViewModel.LoadInvitationsAsync();
    }

    private async Task CreateInvitationAsync()
    {
        var result = await ViewModel.CreateInvitationAsync();
        if (result is Success<Invitation>)
        {
            Snackbar.Add("Invitation created successfully.", Severity.Success);
        }
        else if (result is Failure failure)
        {
            Snackbar.Add(failure.ErrorMessage, Severity.Error);
        }
    }

    private async Task DeleteInvitationAsync(Invitation invitation)
    {
        var result = await ViewModel.DeleteInvitationAsync(invitation);
        if (result is Success<bool>)
        {
            Snackbar.Add("Invitation deleted.", Severity.Info);
        }
        else if (result is Failure failure)
        {
            Snackbar.Add(failure.ErrorMessage, Severity.Error);
        }
    }

    private void CopyLink(string code)
    {
        Snackbar.Add($"Link to copy: {InvitationManagerViewModel.BuildInviteLink(code)}", Severity.Info);
    }
}
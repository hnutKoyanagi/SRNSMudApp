@page "/Admin/Reports"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@namespace SRNSMudApp.Components.Admin

<PageTitle>通報管理 (Reports)</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">
    <MudIcon Icon="@Icons.Material.Filled.Report" Class="mr-2 align-middle" />
    不適切な投稿の通報管理
</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    ユーザーから送信された不適切なアイテム・タグの通報一覧です。内容を確認し、処置や却下を行ってください。
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudSelect T="Data.ReportStatus?" Label="ステータス絞り込み" Value="SelectedStatus"
                       ValueChanged="OnStatusFilterChangedAsync" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem Value="@((Data.ReportStatus?)null)">すべてのステータス</MudSelectItem>
                <MudSelectItem Value="@((Data.ReportStatus?)Data.ReportStatus.Pending)">未対応 (Pending)</MudSelectItem>
                <MudSelectItem Value="@((Data.ReportStatus?)Data.ReportStatus.ActionTaken)">処置済み (ActionTaken)</MudSelectItem>
                <MudSelectItem Value="@((Data.ReportStatus?)Data.ReportStatus.Reviewed)">確認済み (Reviewed)</MudSelectItem>
                <MudSelectItem Value="@((Data.ReportStatus?)Data.ReportStatus.Dismissed)">却下 (Dismissed)</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="Data.ReportTargetType?" Label="対象種別絞り込み" Value="SelectedTargetType"
                       ValueChanged="OnTargetTypeFilterChangedAsync" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem Value="@((Data.ReportTargetType?)null)">すべての対象種別</MudSelectItem>
                <MudSelectItem Value="@((Data.ReportTargetType?)Data.ReportTargetType.Item)">アイテムのみ</MudSelectItem>
                <MudSelectItem Value="@((Data.ReportTargetType?)Data.ReportTargetType.Tag)">タグのみ</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-center justify-end">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadReportsAsync" Disabled="IsLoading">
                再読み込み
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="@Reports" Hover="true" Dense="true" Elevation="1" Loading="@IsLoading"
          LoadingProgressColor="Color.Primary">
    <HeaderContent>
        <MudTh>ID</MudTh>
        <MudTh>通報日時</MudTh>
        <MudTh>種別</MudTh>
        <MudTh>通報対象 (内容スナップショット)</MudTh>
        <MudTh>通報理由</MudTh>
        <MudTh>通報者</MudTh>
        <MudTh>ステータス</MudTh>
        <MudTh>対応</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="ID">@context.Id</MudTd>
        <MudTd DataLabel="通報日時">@context.CreatedDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</MudTd>
        <MudTd DataLabel="種別">
            <MudChip T="string" Color="@ReportManagerViewModel.GetTargetTypeColor(context.TargetType)" Size="Size.Small"
                     Variant="Variant.Outlined">
                @ReportManagerViewModel.GetTargetTypeText(context.TargetType)
            </MudChip>
        </MudTd>
        <MudTd DataLabel="通報対象"
               Style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            <MudTooltip Text="@context.TargetContentSnapshot">
                <span>@context.TargetContentSnapshot</span>
            </MudTooltip>
        </MudTd>
        <MudTd DataLabel="通報理由">
            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Text">
                @context.Reason
            </MudChip>
        </MudTd>
        <MudTd DataLabel="通報者">@(context.Owner?.UserName ?? "不明")</MudTd>
        <MudTd DataLabel="ステータス">
            <MudChip T="string" Color="@ReportManagerViewModel.GetStatusColor(context.Status)" Size="Size.Small"
                     Variant="Variant.Filled">
                @ReportManagerViewModel.GetStatusText(context.Status)
            </MudChip>
        </MudTd>
        <MudTd DataLabel="対応">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenDetailDialogAsync(context))">
                詳細・対応
            </MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4 text-center" Color="Color.Secondary">該当する通報はありません。</MudText>
    </NoRecordsContent>
</MudTable>

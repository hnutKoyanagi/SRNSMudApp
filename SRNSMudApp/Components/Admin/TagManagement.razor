@page "/Admin/TagManagement"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using SRNSMudApp.Data
@using SRNSMudApp.Services
@inject ITagLockService TagLockService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-5">
    <div class="d-flex align-center mb-4">
        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Class="mr-2" Size="Size.Large"
                 Color="Color.Primary" />
        <MudText Typo="Typo.h4">タグ管理</MudText>
    </div>

    @* 階層ロック設定カード *@
    <MudCard Outlined="true" Class="mb-5 rounded-xl">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">階層ロック設定</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    n階層目までのタグをロックします。ロックされたタグの兄弟は新規作成・編集・削除が不能となります。
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                @if (_currentConfiguredLevel > 0)
                {
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled">
                        第@_currentConfiguredLevel 階層までロック中
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">
                        階層ロック: 無効
                    </MudChip>
                }
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <div class="d-flex align-center gap-4 flex-wrap">
                <MudNumericField @bind-Value="_inputLevel" Label="ロックする階層（n階層目まで）" Min="0" Max="20" Step="1"
                                 Variant="Variant.Outlined"
                                 HelperText="0 を指定すると階層ロックは無効になります（個別ロックのみ適用）。1 はルート直下の子タグ、2 はその子タグまでが対象です。"
                                 Style="max-width: 320px;" Immediate="true" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveHierarchyLockSettingAsync" Disabled="_isSavingSetting">
                    設定を保存
                </MudButton>
            </div>
            <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true" Elevation="0">
                階層設定によりロックされた階層のタグおよびその兄弟タグは、一般ユーザー・管理者問わず作成・編集・削除が制限されます。
            </MudAlert>
        </MudCardContent>
    </MudCard>

    @* タグ一覧とロック状態 *@
    <MudCard Outlined="true" Class="rounded-xl">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                    <div>
                        <MudText Typo="Typo.h6">タグ一覧とロック状態</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            タグごとの階層レベル、ロック状態の確認および個別ロックの切り替えを行えます。
                        </MudText>
                    </div>
                    <MudTextField @bind-Value="_searchString" Placeholder="タグ名・親タグ・作成者で検索..."
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium"
                                  Class="mt-0" Immediate="true" Clearable="true" Style="max-width: 300px;" />
                </div>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (_isLoading)
            {
                <div class="d-flex justify-center pa-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else
            {
                <MudTable Items="@FilteredTags" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0"
                          RowsPerPage="20">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>タグ名</MudTh>
                        <MudTh>階層</MudTh>
                        <MudTh>親タグ</MudTh>
                        <MudTh>作成者</MudTh>
                        <MudTh>ロック状態</MudTh>
                        <MudTh Style="text-align: right;">操作</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.Id</MudTd>
                        <MudTd DataLabel="タグ名">
                            <div class="d-flex align-center gap-1">
                                @if (context.IsLockedEffective)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Error" />
                                }
                                <MudLink Href="@($"/TagDetail/{context.Id}")" Typo="Typo.body2" Class="font-weight-bold">
                                    @context.Name
                                </MudLink>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="階層">
                            @if (context.Level == 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Filled">ルート (0)
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">第
                                    @context.Level 階層</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="親タグ">
                                @(context.ParentTagName ?? (context.Level == 0 ? "-" : "全て∀"))
                            </MudTd>
                            <MudTd DataLabel="作成者">@(context.OwnerUserName ?? "-")</MudTd>
                            <MudTd DataLabel="ロック状態">
                                <div class="d-flex align-center gap-1 flex-wrap">
                                    @if (context.Name == Tag.RootTagName)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Outlined">ルート固定
                                        </MudChip>
                                    }
                                    else if (context.IsDirectlyLocked)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">個別ロック
                                        </MudChip>
                                    }
                                    @if (context.IsLevelLocked && context.Name != Tag.RootTagName)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">階層ロック
                                        </MudChip>
                                    }
                                    @if (context.IsSiblingLocked && !context.IsDirectlyLocked && !context.IsLevelLocked)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">兄弟がロック中
                                        </MudChip>
                                    }
                                    @if (!context.IsLockedEffective)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">未ロック
                                        </MudChip>
                                    }
                                </div>
                            </MudTd>
                            <MudTd DataLabel="操作" Style="text-align: right;">
                                @if (context.Name != Tag.RootTagName)
                                {
                                    @if (context.IsDirectlyLocked)
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.LockOpen" Class="mr-1"
                                                   OnClick="@(() => ToggleTagLockAsync(context.Id))">
                                            ロック解除
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Lock" Class="mr-1"
                                                   OnClick="@(() => ToggleTagLockAsync(context.Id))">
                                            個別ロック
                                        </MudButton>
                                    }
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Color="Color.Primary"
                                               Href="@($"/TagDetail/{context.Id}")" Title="詳細を表示" />
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 10, 20, 50, 100 }" />
                        </PagerContent>
                    </MudTable>
                }
            </MudCardContent>
        </MudCard>
    </MudContainer>

@code {
    private int _currentConfiguredLevel;
    private int _inputLevel;
    private bool _isSavingSetting;
    private bool _isLoading = true;
    private string? _searchString;
    private IReadOnlyList<TagLockItemDto> _tags = [];

    private IEnumerable<TagLockItemDto> FilteredTags =>
        TagManagementViewModel.FilterTags(_tags, _searchString);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _currentConfiguredLevel = await TagLockService.GetLockedHierarchyLevelAsync();
            _inputLevel = _currentConfiguredLevel;
            _tags = await TagLockService.GetAllTagsWithLockStatusAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveHierarchyLockSettingAsync()
    {
        _isSavingSetting = true;
        try
        {
            await TagLockService.SetLockedHierarchyLevelAsync(_inputLevel);
            Snackbar.Add($"階層ロック設定を {_inputLevel} 階層目までに更新しました。", Severity.Success);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"設定の保存に失敗しました: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSavingSetting = false;
        }
    }

    private async Task ToggleTagLockAsync(int tagId)
    {
        try
        {
            bool isLocked = await TagLockService.ToggleTagLockAsync(tagId);
            Snackbar.Add(isLocked ? "タグを個別ロックしました。" : "タグの個別ロックを解除しました。", Severity.Success);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"ロック操作に失敗しました: {ex.Message}", Severity.Error);
        }
    }
}


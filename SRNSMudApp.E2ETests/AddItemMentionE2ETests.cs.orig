using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Playwright;
using Microsoft.Playwright.NUnit;

using SRNSMudApp.Data;

namespace SRNSMudApp.E2ETests;

[Parallelizable(ParallelScope.Self)]
[TestFixture]
public class AddItemMentionE2ETests : PageTest
{
    private CustomWebApplicationFactory _factory = null!;
    private string _serverAddress = "";

    [OneTimeSetUp]
    public void OneTimeSetUp()
    {
        _factory = SharedTestServerFixture.Factory;
        _serverAddress = SharedTestServerFixture.ServerAddress;
    }

    [Test]
    public async Task GivenAddItemInput_WhenTypeMultiLineAndMention_ThenReplacesWithLink()
    {
        var testEmail = $"testmention-{Guid.NewGuid():N}@example.com";
        Page.Console += (_, e) => Console.WriteLine($"Browser Console: {e.Type}: {e.Text}");
        Page.PageError += (_, e) => Console.WriteLine($"Browser Error: {e}");
        await WebAuthnTestHelpers.LoginWithMockGoogleAsync(Page, _serverAddress, testEmail);

        string userId;
        using (var scope = _factory.AppServices.CreateScope())
        {
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var user = await db.Users.FirstOrDefaultAsync(u => u.Email == testEmail);
            userId = user!.Id;
            if (!await db.Tags.AnyAsync(t => t.Name == "C#"))
            {
                db.Tags.Add(new Tag { Name = "C#", OwnerId = userId });
                await db.SaveChangesAsync();
            }
        }

        await Page.GotoAsync($"{_serverAddress}/Item/ItemList");

        var input = Page.GetByPlaceholder("新しいアイテムのコンテンツを入力...");
        await input.WaitForAsync();

        // 1行目に文字を入力
        await input.PressSequentiallyAsync("Line 1");
        // 改行して2行目に文字を入力
        await input.PressAsync("Enter");
        await input.PressSequentiallyAsync("Line 2");

        // 2行目の先頭に移動 (Home) して改行
        await input.PressAsync("Home");
        await input.PressAsync("Enter");
        
        // 元の行に戻るために上へ
        await input.PressAsync("ArrowUp");

        // # を入力
        await input.PressSequentiallyAsync("#C", new() { Delay = 100 });

        // Autocomplete popover (Tribute.js container) should appear
        var popover = Page.Locator(".tribute-container").Locator("text=C#");
        await Expect(popover).ToBeVisibleAsync();

        // Select the item
        await popover.ClickAsync();

        // Verify the input has the internal link
        await Expect(input).ToHaveValueAsync(new System.Text.RegularExpressions.Regex("/TagDetail/"));

        // Save the form
        await Page.GetByRole(AriaRole.Button, new PageGetByRoleOptions { Name = "保存" }).ClickAsync();

        // The item card should appear in the feed with the link
        var itemCard = Page.Locator(".mud-card-content").First;
        await Expect(itemCard).ToBeVisibleAsync();
        await Expect(itemCard).ToContainTextAsync("Line 1");
    }
}

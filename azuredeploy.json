{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "manual"
    },
    "description": "SRNSMudApp Free Tier Azure Deployment Template (App Service F1 + Azure SQL Serverless Free Offer)"
  },
  "parameters": {
    "appNamePrefix": {
      "type": "string",
      "defaultValue": "srns",
      "minLength": 3,
      "maxLength": 10,
      "metadata": {
        "description": "リソース名に使用するプレフィックス（英数字小文字、3〜10文字推奨）。"
      }
    },
    "sqlAdministratorLogin": {
      "type": "string",
      "defaultValue": "sqladmin",
      "metadata": {
        "description": "Azure SQL Database の管理者ユーザー名。"
      }
    },
    "sqlAdministratorLoginPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Azure SQL Database の管理者パスワード（8文字以上、大文字・小文字・数字・記号を含む必要があります）。"
      }
    },
    "systemUserInitialPassword": {
      "type": "securestring",
      "metadata": {
        "description": "SRNSMudApp 内のビルトイン管理者アカウント (system) の初期パスワード（本番環境起動時に必須）。"
      }
    },
    "repositoryUrl": {
      "type": "string",
      "defaultValue": "https://github.com/koyakei/SRNSMudApp.git",
      "metadata": {
        "description": "デプロイ元の Git リポジトリ URL。"
      }
    },
    "branch": {
      "type": "string",
      "defaultValue": "master",
      "metadata": {
        "description": "デプロイ対象のブランチ名。"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "リソースを配置する Azure リージョン。"
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[uniqueString(resourceGroup().id)]",
    "appServicePlanName": "[format('{0}-asp-{1}', parameters('appNamePrefix'), variables('uniqueSuffix'))]",
    "webAppName": "[format('{0}-app-{1}', parameters('appNamePrefix'), variables('uniqueSuffix'))]",
    "sqlServerName": "[format('{0}-sql-{1}', parameters('appNamePrefix'), variables('uniqueSuffix'))]",
    "sqlDatabaseName": "srnsdb"
  },
  "resources": [
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2022-05-01-preview",
      "name": "[variables('sqlServerName')]",
      "location": "[parameters('location')]",
      "properties": {
        "administratorLogin": "[parameters('sqlAdministratorLogin')]",
        "administratorLoginPassword": "[parameters('sqlAdministratorLoginPassword')]",
        "version": "12.0",
        "publicNetworkAccess": "Enabled",
        "minimalTlsVersion": "1.2"
      }
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2022-05-01-preview",
      "name": "[format('{0}/AllowAllWindowsAzureIps', variables('sqlServerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ],
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      }
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2022-08-01-preview",
      "name": "[format('{0}/{1}', variables('sqlServerName'), variables('sqlDatabaseName'))]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ],
      "sku": {
        "name": "GP_S_Gen5_1",
        "tier": "GeneralPurpose",
        "family": "Gen5",
        "capacity": 1
      },
      "properties": {
        "collation": "SQL_Latin1_General_CP1_CI_AS",
        "maxSizeBytes": 34359738368,
        "useFreeLimit": true,
        "freeLimitExhaustionBehavior": "AutoPause",
        "autoPauseDelay": 60,
        "minCapacity": 0.5
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-09-01",
      "name": "[variables('appServicePlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "F1",
        "tier": "Free",
        "size": "F1",
        "family": "F",
        "capacity": 1
      },
      "properties": {
        "reserved": false
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-09-01",
      "name": "[variables('webAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
        "[resourceId('Microsoft.Sql/servers/databases', variables('sqlServerName'), variables('sqlDatabaseName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "webSocketsEnabled": true,
          "netFrameworkVersion": "v8.0",
          "connectionStrings": [
            {
              "name": "DefaultConnection",
              "connectionString": "[format('Server=tcp:{0}.database.windows.net,1433;Initial Catalog={1};Persist Security Info=False;User ID={2};Password={3};MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;', variables('sqlServerName'), variables('sqlDatabaseName'), parameters('sqlAdministratorLogin'), parameters('sqlAdministratorLoginPassword'))]",
              "type": "SQLAzure"
            }
          ],
          "appSettings": [
            {
              "name": "ASPNETCORE_ENVIRONMENT",
              "value": "Production"
            },
            {
              "name": "AUTO_MIGRATE",
              "value": "true"
            },
            {
              "name": "SYSTEM_USER_INITIAL_PASSWORD",
              "value": "[parameters('systemUserInitialPassword')]"
            },
            {
              "name": "PROJECT",
              "value": "SRNSMudApp/SRNSMudApp.csproj"
            },
            {
              "name": "SCM_COMMAND_IDLE_TIMEOUT",
              "value": "600"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Web/sites/sourcecontrols",
      "apiVersion": "2022-09-01",
      "name": "[format('{0}/web', variables('webAppName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('webAppName'))]"
      ],
      "properties": {
        "repoUrl": "[parameters('repositoryUrl')]",
        "branch": "[parameters('branch')]",
        "isManualIntegration": true
      }
    }
  ],
  "outputs": {
    "webAppUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('webAppName'))).defaultHostName)]"
    },
    "sqlServerFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Sql/servers', variables('sqlServerName'))).fullyQualifiedDomainName]"
    }
  }
}